<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Disable status messages from Logback itself (suppresses appender warnings) -->
    <statusListener class="ch.qos.logback.core.status.NopStatusListener" />

    <!-- Simple console appender for tests - avoids Logstash connection attempts -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    
    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
    
    <!-- Reduce noise from Spring and infrastructure during tests -->
    <logger name="org.springframework" level="WARN"/>
    <logger name="org.springframework.boot" level="WARN"/>
    <logger name="org.springframework.test" level="WARN"/>
    <logger name="org.hibernate" level="WARN"/>
    <logger name="org.testcontainers" level="WARN"/>
    <logger name="com.github.dockerjava" level="WARN"/>
    
    <!-- Completely suppress Logstash appender warnings and errors -->
    <logger name="net.logstash.logback" level="OFF"/>
    <logger name="net.logstash.logback.appender" level="OFF"/>
    
    <!-- Keep our application logs visible -->
    <logger name="org.sifunity.broker.eventsconnector" level="DEBUG"/>
</configuration>
