# Environment Service - Docker Compose Configuration
# Copy this file to .env and customize as needed

# PostgreSQL Configuration
POSTGRES_DB=sif_broker
POSTGRES_USER=sif_broker
POSTGRES_PASSWORD=changeme

# Database Connection (for environment-service)
DB_USERNAME=sif_broker
DB_PASSWORD=changeme

# Server Configuration
SERVER_PORT=8081

# Authentication Settings
AUTHENTICATION_TIMESTAMP_TOLERANCE_MINUTES=5

# Logging Level (DEBUG, INFO, WARN, ERROR)
LOGGING_LEVEL=INFO

# JVM Memory Settings (for development)
JAVA_OPTS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -Xms256m -Xmx512m
