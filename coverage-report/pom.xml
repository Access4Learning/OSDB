<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.sifunity.broker</groupId>
        <artifactId>sif-unity-broker</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>coverage-report</artifactId>
    <name>Coverage Report (Aggregate)</name>
    <description>Aggregates JaCoCo coverage reports from all modules into a single report</description>

    <dependencies>
        <!-- List all modules whose coverage should be aggregated -->
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>sif-broker-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>environment-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>queue-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>subscription-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>job-service</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>gateway</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>events-connector</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>requests-connector</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>responses-connector</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.sifunity.broker</groupId>
            <artifactId>services-connector</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>0.8.11</version>
                <executions>
                    <execution>
                        <id>report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
