# SIF Unity Broker API Test Credentials
# Copy this file to .env and fill in your actual credentials

# ========================================
# Credential Naming Pattern
# ========================================
# All credentials follow the pattern: {prefix}-{role}SessionToken and {prefix}-{role}SharedSecret
# Where:
#   - prefix = environment name (local, docker, kubernetes, standalone, etc.)
#   - role = consumer or provider
#
# The prefix is set in the Bruno environment file as "currentEnv"
# The role is passed to auth.setAuthHeaders(req, bru, 'consumer') or 'provider'

# ========================================
# Local Development Environment
# ========================================
# For infrastructure tests (single credential set, use 'consumer' role)
local-consumerSessionToken=your-session-token-here
local-consumerSharedSecret=your-shared-secret-here

# ========================================
# Docker Compose Environment
# ========================================
# For infrastructure tests (single credential set, use 'consumer' role)
docker-consumerSessionToken=your-session-token-here
docker-consumerSharedSecret=your-shared-secret-here

# ========================================
# Kubernetes Environment
# ========================================
# For infrastructure tests (single credential set, use 'consumer' role)
kubernetes-consumerSessionToken=your-session-token-here
kubernetes-consumerSharedSecret=your-shared-secret-here

# ========================================
# Standalone Environment
# ========================================
# For testing against existing SIF solution (separate consumer and provider credentials)

# Consumer 1 credentials
standalone-consumer1SessionToken=your-consumer1-session-token-here
standalone-consumer1SharedSecret=your-consumer1-shared-secret-here

# Consumer 2 credentials
standalone-consumer2SessionToken=your-consumer2-session-token-here
standalone-consumer2SharedSecret=your-consumer2-shared-secret-here

# Provider credentials
standalone-providerSessionToken=your-provider-session-token-here
standalone-providerSharedSecret=your-provider-shared-secret-here

# ========================================
# AWS Demo Environment
# ========================================
# Gateway URL (ALB DNS name)
AWS_DEMO_GATEWAY_URL=http://your-alb-dns-name.us-east-1.elb.amazonaws.com

# Admin credentials (from Secrets Manager: osdb/admin/bootstrap-credentials)
aws-demo-adminSessionToken=your-admin-session-token
aws-demo-adminSharedSecret=your-admin-shared-secret
