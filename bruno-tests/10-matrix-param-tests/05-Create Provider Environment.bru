meta {
  name: 05-Create Provider Environment
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/{{mpDomainId}}/{{mpSolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environment": {
      "consumerName": "MPProvider-{{$timestamp}}",
      "type": "BROKERED",
      "defaultZone": {
        "id": "{{mpZoneId}}"
      }
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody().environment;
    bru.setVar('mpProviderEnvId', data.id);
    bru.setVar('mpProviderSessionToken', data.sessionToken);
    bru.setVar('mpProviderSharedSecret', data.sharedSecret);
    console.log('Created provider environment:', data.id);
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
  res.body.environment.sessionToken: isDefined
}

tests {
  test("Provider environment created", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().environment;
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
  });
}
