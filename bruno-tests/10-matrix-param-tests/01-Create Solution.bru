meta {
  name: 01-Create Solution
  type: http
  seq: 2
}

post {
  url: {{gatewayUrl}}/{{mpDomainId}}/solutions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "solutionId": "mp-solution-{{$timestamp}}",
    "description": "Solution for matrix parameter tests"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('mpSolutionId', data.solutionId);
    bru.setVar('mpSolutionUuid', data.id);
    console.log('Created solution:', data.solutionId, '(UUID:', data.id, ')');
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Solution created with UUID", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.id).to.exist;
    expect(data.solutionId).to.exist;
  });
}
