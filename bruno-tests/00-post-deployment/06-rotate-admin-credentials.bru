meta {
  name: 06 Rotate Admin Credentials
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/GLOBAL_DOMAIN/GLOBAL_SOLUTION/environments/{{adminEnvironmentId}}/rotate-credentials
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "sessionToken": "MYTOKEN",
    "sharedSecret": "MYSECRET"
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.sessionToken: isDefined
  res.body.sharedSecret: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    console.log('=============================================');
    console.log('NEW ADMIN CREDENTIALS - SAVE THESE NOW:');
    console.log('  Environment ID:', data.id);
    console.log('  New Session Token:', data.sessionToken);
    console.log('  New Shared Secret:', data.sharedSecret);
    console.log('  Rotated At:', data.rotatedAt);
    console.log('=============================================');
    console.log('');
    console.log('UPDATE YOUR .env FILE:');
    console.log('  aws-demo-adminSessionToken=' + data.sessionToken);
    console.log('  aws-demo-adminSharedSecret=' + data.sharedSecret);
    console.log('');
    console.log('Old credentials are now INVALID.');
  }
}

tests {
  test("Credentials rotated successfully", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data).to.have.property('id');
    expect(data).to.have.property('sessionToken');
    expect(data).to.have.property('sharedSecret');
    expect(data).to.have.property('rotatedAt');
  });
}

docs {
  # Rotate Admin Credentials
  
  Rotates the admin environment's session token and shared secret.
  Old credentials are immediately invalidated.
  
  ## IMPORTANT
  
  The new shared secret is shown ONLY in this response. Save it immediately.
  Update your .env file with the new values printed in the console output.
  
  ## Prerequisites
  - Admin environment must exist (bootstrapped on first deploy)
  - You need the admin environment's UUID (set as `adminEnvironmentId` variable)
  - Current admin credentials must be valid
  
  ## Setup
  
  Before running this test, set the `adminEnvironmentId` variable.
  You can get it from the environment list (test 05) — look for the ADMIN type environment.
}
