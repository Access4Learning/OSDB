meta {
  name: 00 Verify Admin Credentials
  type: http
  seq: 0
}

get {
  url: {{gatewayUrl}}/{{domainId}}/{{solutionId}}/environments
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

tests {
  test("Admin credentials are valid", function() {
    // 200 = credentials work, environment-service is reachable
    // 404 = credentials work but no domain/solution exists yet (that's fine)
    // 401/403 = credentials are WRONG
    const status = res.getStatus();
    expect(status).to.not.equal(401);
    expect(status).to.not.equal(403);
    console.log('Admin auth status:', status);
    if (status === 200) {
      console.log('Admin credentials verified - system is fully bootstrapped');
    } else if (status === 404) {
      console.log('Admin credentials valid - domain/solution not yet created (run steps 02-03)');
    }
  });
}

docs {
  # Verify Admin Credentials
  
  Quick check that the admin session token and shared secret from your .env
  file match what's bootstrapped in the database.
  
  ## Expected Results
  - 200: System is fully set up, credentials work
  - 404: Credentials work but domain/solution don't exist yet (run next steps)
  - 401/403: Credentials are WRONG — check your .env values match what's in Secrets Manager
  
  ## If This Fails (401)
  
  Your .env credentials don't match what the environment-service bootstrapped with.
  Check:
  1. What's in Secrets Manager (`osdb/admin/bootstrap-credentials`)
  2. Whether the environment-service actually used those values (check its startup logs for "Admin environment already exists" vs "Bootstrapping admin environment")
  3. If the DB was created before the Secrets Manager values were wired in, the defaults (`admin-bootstrap-token` / `admin-bootstrap-secret`) were used instead
}
