meta {
  name: 08-Create Consumer Environment
  type: http
  seq: 11
}

post {
  url: {{gatewayUrl}}/{{altDomainId}}/{{altSolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environment": {
      "consumerName": "AlertFlowConsumer-{{$timestamp}}",
      "type": "BROKERED"
    }
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
  res.body.environment.sessionToken: isDefined
}

script:pre-request {
  const solutionId = bru.getVar('altSolutionId');
  if (!solutionId) {
    throw new Error('altSolutionId not set. Run step 01 first.');
  }

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody().environment;
    bru.setVar('altConsumerEnvId', data.id);
    bru.setVar('altConsumerSessionToken', data.sessionToken);
    bru.setVar('altConsumerSharedSecret', data.sharedSecret);
    console.log('Created consumer environment:', data.id);
  }
}

tests {
  test("Consumer environment created", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().environment;
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
    expect(data.sharedSecret).to.exist;
  });
}
