meta {
  name: 13-Consumer Get Next Message
  type: http
  seq: 16
}

get {
  url: {{gatewayUrl}}/{{altDomainId}}/{{altSolutionId}}/queues/{{altConsumerQueueId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  connectionId: altConsumer
  X-Environment-Id: {{altConsumerEnvId}}
}

assert {
  res.status: in [200, 204]
}

script:pre-request {
  const queueId = bru.getVar('altConsumerQueueId');
  if (!queueId) {
    throw new Error('altConsumerQueueId not set. Run step 10 first.');
  }

  const envId = bru.getVar('altConsumerEnvId');
  if (!envId) {
    throw new Error('altConsumerEnvId not set. Run step 08 first.');
  }

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'altConsumer' });
}

script:post-response {
  if (res.getStatus() === 200) {
    const messageId = res.getHeaders()?.messageid;
    if (messageId) {
      bru.setVar('altConsumerLastMessageId', messageId);
      console.log('Delivered message ID (for ACK):', messageId);
    }
    console.log('Delivered payload:', JSON.stringify(res.getBody(), null, 2));
  } else if (res.getStatus() === 204) {
    console.log('No message available for consumer yet.');
  }
}

tests {
  test("Consumer request succeeds", function() {
    expect([200, 204]).to.include(res.getStatus());
  });

  test("Message delivered with messageid header", function() {
    if (res.getStatus() === 200) {
      const headers = res.getHeaders();
      expect(res.getBody()).to.exist;
      expect(headers).to.have.property('messageid');
    }
  });
}

docs {
  # Consumer Get Next Message
  
  Consumer retrieves the next message from their queue. This should be
  the TESTOBJECT1s event emitted by the provider in step 12.
  
  ## SIF Semantics
  
  - First call (no deleteMessageId): returns the oldest undelivered message
  - The `messageid` response header is the ID to pass as `deleteMessageId` to ACK
  
  ## Expected Response
  
  - Status: 200 OK with the event payload
  - Header: `messageid` — the message UUID for ACK
}
