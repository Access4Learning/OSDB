meta {
  name: 02-Create Zone
  type: http
  seq: 3
}

post {
  url: {{gatewayUrl}}/{{altDomainId}}/{{altSolutionId}}/zones/zone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  X-Run-As-Environment: broker-services
}

body:json {
  {
    "zone": {
      "id": "AlertFlowZone-{{$timestamp}}",
      "description": "Zone for alerts flow object services"
    }
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  const domainId = bru.getVar('altDomainId');
  const solutionId = bru.getVar('altSolutionId');
  if (!domainId || !solutionId) {
    throw new Error('altDomainId or altSolutionId not set. Run steps 00-01 first.');
  }

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('altZoneId', data.zone.id);
    console.log('Created alerts flow zone:', bru.getVar('altZoneId'));
  }
}

tests {
  test("Zone created for object services", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
