meta {
  name: 12-Poll Queue for State Response
  type: http
  seq: 25
}

get {
  url: {{gatewayUrl}}/{{fsDomainId}}/{{fsSolutionId}}/queues/{{fsConsumerQueueId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  connectionId: fsConsumer
  X-Environment-Id: {{fsConsumerEnvId}}
  deleteMessageId: {{fsLastMessageId}}
}

script:pre-request {
  const queueId = bru.getVar('fsConsumerQueueId');
  if (!queueId) {
    throw new Error('Consumer queue ID not set. Run step 06 first.');
  }

  const lastMessageId = bru.getVar('fsLastMessageId');
  if (lastMessageId) {
    console.log('ACKing previous message:', lastMessageId);
  }

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'fsConsumer' });
}

script:post-response {
  const status = res.getStatus();
  if (status === 200) {
    const messageId = res.getHeaders()?.messageid;
    if (messageId) {
      bru.setVar('fsLastMessageId', messageId);
      console.log('Delivered message ID:', messageId);
    }
    console.log('State response payload:', JSON.stringify(res.getBody(), null, 2));
  } else if (status === 204) {
    console.log('No message available. State response may not have arrived yet.');
    bru.setVar('fsLastMessageId', '');
  }
}

assert {
  res.status: in [200, 204]
}

tests {
  test("Queue poll succeeds", function() {
    expect([200, 204]).to.include(res.getStatus());
  });

  test("If message delivered, it has messageid header", function() {
    if (res.getStatus() === 200) {
      const headers = res.getHeaders();
      expect(headers).to.have.property('messageid');
    }
  });
}

docs {
  # Poll Consumer Queue for State Response

  ACKs the previous message (phase response) and retrieves the next
  message from the consumer's queue — the delayed response from the
  phase state update.

  ## Expected Response

  - Status: 200 OK when a message is delivered
  - Status: 204 No Content when the queue is empty
}
