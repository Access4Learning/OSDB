meta {
  name: 05b-Create Provider Queue
  type: http
  seq: 11
}

post {
  url: {{gatewayUrl}}/{{fsDomainId}}/{{fsSolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "DEFAULTQUEUE",
      "ownerId": "{{fsProviderEnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'fsProvider' });
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('fsProviderQueueId', data.queue.id);
    console.log('Created provider queue:', data.queue.id);
  }
}

assert {
  res.status: eq 201
  res.body.queue.id: isDefined
}

tests {
  test("Provider queue created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().queue.name).to.equal('DEFAULTQUEUE');
  });
}

docs {
  # Create Provider Queue

  Creates a queue for the provider environment. In the DELAYED_to_DELAYED
  pattern, the broker enqueues consumer requests into this queue. The
  provider polls this queue to receive functional service requests.

  This is required before creating the provider's DELAYED_REQUEST
  subscription in the next step.
}
