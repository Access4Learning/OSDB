meta {
  name: 08-Poll Queue for Job Response
  type: http
  seq: 17
}

get {
  url: {{gatewayUrl}}/{{fsDomainId}}/{{fsSolutionId}}/queues/{{fsConsumerQueueId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  connectionId: fsConsumer
  X-Environment-Id: {{fsConsumerEnvId}}
}

script:pre-request {
  const queueId = bru.getVar('fsConsumerQueueId');
  if (!queueId) {
    throw new Error('Consumer queue ID not set. Run step 06 first.');
  }

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'fsConsumer' });
}

script:post-response {
  const status = res.getStatus();
  if (status === 200) {
    const messageId = res.getHeaders()?.messageid;
    if (messageId) {
      bru.setVar('fsLastMessageId', messageId);
      console.log('Delivered message ID:', messageId);
    }

    const body = res.getBody();
    console.log('Job response payload:', JSON.stringify(body, null, 2));

    // Try to extract jobId from the response for subsequent tests
    if (body && body.id) {
      bru.setVar('fsJobId', body.id);
      console.log('Extracted jobId:', body.id);
    } else if (body && body.job && body.job.id) {
      bru.setVar('fsJobId', body.job.id);
      console.log('Extracted jobId:', body.job.id);
    }
  } else if (status === 204) {
    console.log('No message available yet. The DELAYED response may not have arrived.');
  }
}

assert {
  res.status: in [200, 204]
}

tests {
  test("Queue poll succeeds", function() {
    expect([200, 204]).to.include(res.getStatus());
  });

  test("If message delivered, it has messageid header", function() {
    if (res.getStatus() === 200) {
      const headers = res.getHeaders();
      expect(headers).to.have.property('messageid');
      expect(res.getBody()).to.exist;
    }
  });
}

docs {
  # Poll Consumer Queue for Job Response

  Polls the consumer's queue to retrieve the delayed response from the
  job creation request. The services-connector forwards the request to
  the provider asynchronously and delivers the provider's response to
  this queue.

  ## Expected Response

  - Status: 200 OK when a message is delivered (with `messageid` header)
  - Status: 204 No Content when the queue is empty (response not yet delivered)
  - Body: The provider's response payload for the job creation
}
