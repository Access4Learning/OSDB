meta {
  name: 07b-Provider Poll Queue for Job Request
  type: http
  seq: 15
}

get {
  url: {{gatewayUrl}}/{{fsDomainId}}/{{fsSolutionId}}/queues/{{fsProviderQueueId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  connectionId: fsProvider
  X-Environment-Id: {{fsProviderEnvId}}
}

script:pre-request {
  const queueId = bru.getVar('fsProviderQueueId');
  if (!queueId) {
    throw new Error('Provider queue ID not set. Run step 05b first.');
  }

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'fsProvider' });
}

script:post-response {
  const status = res.getStatus();
  if (status === 200) {
    const headers = res.getHeaders();
    const messageId = headers?.messageid;
    if (messageId) {
      bru.setVar('fsProviderLastMessageId', messageId);
      console.log('Provider received request message ID:', messageId);
    }

    // Extract SIF headers returned by queue-service
    // These were stored when the message was enqueued
    if (headers.queueid) {
      bru.setVar('fsResponseQueueId', headers.queueid);
      console.log('Consumer queueId (from header):', headers.queueid);
    }
    if (headers.requestid) {
      bru.setVar('fsResponseRequestId', headers.requestid);
      console.log('RequestId (from header):', headers.requestid);
    }

    // Fallback: check body if headers not present
    const body = res.getBody();
    if (!bru.getVar('fsResponseQueueId') && body && body.queueId) {
      bru.setVar('fsResponseQueueId', body.queueId);
      console.log('Consumer queueId (from body fallback):', body.queueId);
    }
    if (!bru.getVar('fsResponseRequestId') && body) {
      const rid = body.requestId || body.messageId;
      if (rid) {
        bru.setVar('fsResponseRequestId', rid);
        console.log('RequestId (from body fallback):', rid);
      }
    }

    console.log('Job request payload:', JSON.stringify(body, null, 2));
    console.log('All response headers:', JSON.stringify(headers, null, 2));
  } else if (status === 204) {
    console.log('No message available yet.');
  }
}

assert {
  res.status: in [200, 204]
}

tests {
  test("Provider queue poll succeeds", function() {
    expect([200, 204]).to.include(res.getStatus());
  });

  test("If message delivered, has messageid header", function() {
    if (res.getStatus() === 200) {
      expect(res.getHeaders()).to.have.property('messageid');
    }
  });
}

docs {
  # Provider Poll Queue for Job Request

  Provider polls its DELAYED_REQUEST queue. Queue-service returns
  all stored SIF headers (requestId, queueId, serviceType, etc.)
  as HTTP response headers per SIF 3.7 OpenAPI spec.
}
