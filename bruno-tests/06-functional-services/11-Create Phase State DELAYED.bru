meta {
  name: 11-Create Phase State DELAYED
  type: http
  seq: 22
}

post {
  url: {{gatewayUrl}}/{{fsDomainId}}/{{fsSolutionId}}/services/DataExport/{{fsJobId}}/extraction/states/state
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  zoneId: {{fsZoneId}}
  contextId: DEFAULT
  serviceType: FUNCTIONAL
  requestType: DELAYED
  requestId: {{fsStateRequestId}}
  queueId: {{fsConsumerQueueId}}
  messageId: {{fsStateMessageId}}
}

body:json {
  {
    "state": {
      "type": "INPROGRESS",
      "description": "Extraction phase is now in progress"
    }
  }
}

script:pre-request {
  const jobId = bru.getVar('fsJobId');
  if (!jobId) {
    console.warn('Job ID not set — using placeholder.');
    bru.setVar('fsJobId', '00000000-0000-0000-0000-000000000000');
  }

  const crypto = require('crypto');
  const requestId = crypto.randomUUID();
  bru.setVar('fsStateRequestId', requestId);

  const messageId = crypto.randomUUID();
  bru.setVar('fsStateMessageId', messageId);

  console.log('State DELAYED requestId:', requestId);

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'fsConsumer' });
}

script:post-response {
  const status = res.getStatus();
  console.log('Create Phase State DELAYED response status:', status);
  if (status === 202) {
    console.log('Phase state update accepted (DELAYED).');
  } else {
    console.error('Unexpected status:', status);
    console.error('Response:', JSON.stringify(res.getBody(), null, 2));
  }
}

assert {
  res.status: eq 202
}

tests {
  test("DELAYED phase state update returns 202 Accepted", function() {
    expect(res.getStatus()).to.equal(202);
  });
}

docs {
  # Create Phase State (DELAYED)

  Consumer sends a DELAYED POST to create/update the state of the "extraction"
  phase. The URL includes the full path to the state sub-resource.

  ## URL Pattern

  `POST /{domainId}/{solutionId}/services/{functionalServiceName}/{jobId}/{phaseName}/states/state`

  ## SIF Headers

  - `serviceType: FUNCTIONAL`
  - `requestType: DELAYED`
  - `requestId` — new correlation ID for this state request
  - `queueId` — consumer's queue for the response

  ## Expected Response

  - Status: 202 Accepted
}
