meta {
  name: Events Connector Health Check
  type: http
  seq: 8
}

get {
  url: {{eventsConnectorUrl}}/actuator/health
  body: none
  auth: none
}

docs {
  # Events Connector Health Check
  
  Verifies that the Events Connector is running and healthy.
  
  ## Expected Response
  
  - Status: 200 OK
  - Body: JSON with status field indicating "UP"
  
  ## What This Tests
  
  - Events Connector is running
  - Service is accessible on the configured port
  - Connectivity to downstream services is working
}

assert {
  res.status: eq 200
  res.body.status: isDefined
}

tests {
  test("Events Connector is healthy", function() {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(200);
    expect(data).to.have.property('status');
    expect(data.status).to.be.oneOf(['UP', 'SERVING']);
  });
  
  test("Response time is acceptable", function() {
    expect(res.getResponseTime()).to.be.below(5000);
  });
}
