meta {
  name: 05-Create Consumer Environment
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/{{immDomainId}}/{{immSolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environment": {
      "consumerName": "ImmediateTestConsumer-{{$timestamp}}",
      "type": "BROKERED"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody().environment;
    bru.setVar('immConsumerEnvId', data.id);
    bru.setVar('immConsumerSessionToken', data.sessionToken);
    bru.setVar('immConsumerSharedSecret', data.sharedSecret);
    console.log('Created consumer environment:', data.id);
    console.log('Consumer session token:', data.sessionToken);
    
    // Extract requests connector URL
    if (data.infrastructureServices && data.infrastructureServices.infrastructureService) {
      const services = data.infrastructureServices.infrastructureService;
      const requestsConn = services.find(s => s.name === 'requestsConnector');
      if (requestsConn) {
        bru.setVar('immConsumerRequestsUrl', requestsConn.value);
        console.log('Consumer Requests URL:', requestsConn.value);
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
  res.body.environment.sessionToken: isDefined
}

tests {
  test("Consumer environment created", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().environment;
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
  });
}
