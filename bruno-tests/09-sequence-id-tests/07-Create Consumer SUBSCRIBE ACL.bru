meta {
  name: 07-Create Consumer SUBSCRIBE ACL
  type: http
  seq: 8
}

post {
  url: {{gatewayUrl}}/{{seqDomainId}}/{{seqSolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{seqConsumerEnvId}}",
    "serviceName": "SEQTESTOBJECTS",
    "zoneId": "{{seqZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "SUBSCRIBE",
    "accessLevel": "APPROVED"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('seqConsumerAclId', data.id);
    console.log('Created consumer SUBSCRIBE ACL:', data.id);
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Consumer SUBSCRIBE ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
