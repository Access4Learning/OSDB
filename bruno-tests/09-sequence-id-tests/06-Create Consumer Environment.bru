meta {
  name: 06-Create Consumer Environment
  type: http
  seq: 7
}

post {
  url: {{gatewayUrl}}/{{seqDomainId}}/{{seqSolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environment": {
      "consumerName": "SeqConsumer-{{$timestamp}}",
      "type": "BROKERED"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody().environment;
    bru.setVar('seqConsumerEnvId', data.id);
    bru.setVar('seqConsumerSessionToken', data.sessionToken);
    bru.setVar('seqConsumerSharedSecret', data.sharedSecret);
    console.log('Created consumer environment:', data.id);
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
}

tests {
  test("Consumer environment created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
