meta {
  name: 09-Create Consumer Subscription
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{seqDomainId}}/{{seqSolutionId}}/subscriptions/subscription
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "subscription": {
      "queueId": "{{seqConsumerQueueId}}",
      "aclEntryId": "{{seqConsumerAclId}}",
      "messageType": "EVENT"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'seqConsumer' });
}

assert {
  res.status: eq 201
  res.body.subscription.id: isDefined
}

tests {
  test("Consumer subscription created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
