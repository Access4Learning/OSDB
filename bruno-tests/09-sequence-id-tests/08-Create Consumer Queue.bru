meta {
  name: 08-Create Consumer Queue
  type: http
  seq: 9
}

post {
  url: {{gatewayUrl}}/{{seqDomainId}}/{{seqSolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "DEFAULTQUEUE",
      "ownerId": "{{seqConsumerEnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'seqConsumer' });
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('seqConsumerQueueId', data.queue.id);
    console.log('Created consumer queue:', data.queue.id);
  }
}

assert {
  res.status: eq 201
  res.body.queue.id: isDefined
}

tests {
  test("Consumer queue created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}
