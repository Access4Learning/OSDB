meta {
  name: 17-Emit Event 2
  type: http
  seq: 18
}

post {
  url: {{gatewayUrl}}/{{seqDomainId}}/{{seqSolutionId}}/events
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  zoneId: {{seqZoneId}}
  contextId: DEFAULT
  messageType: event
  messageId: {{$randomUUID}}
  eventAction: UPDATE
  serviceType: OBJECT
  serviceName: SEQTESTOBJECTS
}

body:json {
  {
    "SEQTESTOBJECTS": {
      "SEQTESTOBJECT": [
        {
          "refId": "{{$randomUUID}}",
          "name": "Event 2 with sequencing enabled"
        }
      ]
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'seqProvider' });
}

assert {
  res.status: in [202, 204]
}

tests {
  test("Event 2 accepted", function() {
    expect([202, 204]).to.include(res.getStatus());
  });
}
