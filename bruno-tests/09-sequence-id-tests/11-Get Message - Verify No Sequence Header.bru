meta {
  name: 11-Get Message - Verify No Sequence Header
  type: http
  seq: 12
}

get {
  url: {{gatewayUrl}}/{{seqDomainId}}/{{seqSolutionId}}/queues/{{seqConsumerQueueId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  connectionId: seqConsumer
  X-Environment-Id: {{seqConsumerEnvId}}
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'seqConsumer' });
}

script:post-response {
  if (res.getStatus() === 200) {
    const messageId = res.getHeaders()?.messageid;
    if (messageId) {
      bru.setVar('seqLastMessageId', messageId);
      console.log('Got message (no sequence tag):', messageId);
    }
    const seqHeader = res.getHeaders()?.['x-sif-sequenceid'];
    console.log('x-sif-sequenceId header:', seqHeader || '(not present)');
  }
}

assert {
  res.status: eq 200
}

tests {
  test("Message delivered", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("x-sif-sequenceId header is NOT present (sequencing disabled)", function() {
    const headers = res.getHeaders();
    expect(headers['x-sif-sequenceid']).to.not.exist;
  });
}

docs {
  # Verify No Sequence Header When Disabled
  
  Retrieves the message from the queue and verifies that the
  x-sif-sequenceId header is NOT present, because the SEQUENCE_ENABLED
  entity tag has not been created yet.
}
