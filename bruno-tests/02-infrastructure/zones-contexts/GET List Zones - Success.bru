meta {
  name: GET List Zones - Success
  type: http
  seq: 1
  tags: [
    nondestructive
  ]
}

get {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/zones
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

tests {
  test("Zones listed successfully", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has SIF collection wrapper", function() {
    const data = res.getBody();
    expect(data.zones).to.exist;
    expect(data.zones.zone).to.be.an('array');
  });
  
  test("environment-global zone exists (auto-created)", function() {
    const data = res.getBody();
    const globalZone = data.zones.zone.find(z => z.id === 'environment-global');
    expect(globalZone).to.exist;
    expect(globalZone.solutionId).to.equal(bru.getVar('createdSolutionId'));
  });
}

docs {
  # List Zones - Success
  
  Lists all zones in the created solution. Should include the auto-created
  environment-global zone with its DEFAULT context.
  
  ## Prerequisites
  
  - Domain and solution must be created first
  - environment-global zone is auto-created when solution is created
}
