meta {
  name: DELETE Delete Domain - Success
  type: http
  seq: 4
  tags: [
    destructive
  ]
}

delete {
  url: {{gatewayUrl}}/domains/{{createdDomainId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 204
}

script:pre-request {
  const domainId = bru.getVar('createdDomainId');
  if (!domainId) {
    throw new Error('No domain ID found. Run "POST Create Domain - Success" first.');
  }
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar('createdDomainId', null);
    console.log('Domain deleted successfully');
  }
}

tests {
  test("Domain deleted successfully", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  # Delete Domain - Success
  
  Deletes a domain by its ID.
  
  ## Prerequisites
  
  - Run "POST Create Domain - Success" first to set `createdDomainId`
  
  ## Expected Response
  
  - Status: 204 No Content
  
  ## What This Tests
  
  - Domain deletion at root-level path
  - Successful cleanup of test domain
}
