meta {
  name: GET List Domains - Success
  type: http
  seq: 2
  tags: [
    nondestructive
  ]
}

get {
  url: {{gatewayUrl}}/domains
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

tests {
  test("Domains listed successfully", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response has SIF collection wrapper", function() {
    const data = res.getBody();
    expect(data.domains).to.exist;
    expect(data.domains.domain).to.be.an('array');
  });
}

docs {
  # List Domains - Success
  
  Retrieves all domains at the root-level `/domains` endpoint.
  
  ## Expected Response
  
  - Status: 200 OK
  - Body: Array of domain objects
  
  ## What This Tests
  
  - Domain listing at root-level path
  - Response is an array of domains
}
