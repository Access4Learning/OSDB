meta {
  name: DELETE Delete ACL - Success
  type: http
  seq: 3
}

delete {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/acl-entries/{{createdAclId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

docs {
  # Delete ACL Entry - Success
  
  Deletes an ACL entry by ID.
}

script:pre-request {
  const aclId = bru.getVar('createdAclId');
  if (!aclId) {
    throw new Error('No ACL ID found. Create an ACL entry first.');
  }
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru);
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar('createdAclId', null);
    console.log('ACL entry deleted successfully');
  }
}

assert {
  res.status: eq 204
}

tests {
  test("ACL entry deleted successfully", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
