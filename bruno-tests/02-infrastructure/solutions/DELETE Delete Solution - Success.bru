meta {
  name: DELETE Delete Solution - Success
  type: http
  seq: 4
}

delete {
  url: {{gatewayUrl}}/{{createdDomainId}}/solutions/{{createdSolutionId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

docs {
  # Delete Solution - Success

  Deletes a solution by its ID under the specified domain.

  ## Prerequisites

  - Run "POST Create Solution - Success" first to set `createdSolutionId`

  ## Expected Response

  - Status: 204 No Content

  ## What This Tests

  - Solution deletion at `/{domainId}/solutions/{solutionId}` path
  - Successful cleanup of test solution
}

script:pre-request {
  const solutionId = bru.getVar('createdSolutionId');
  if (!solutionId) {
    throw new Error('No solution ID found. Run "POST Create Solution - Success" first.');
  }

  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar('createdSolutionId', null);
    console.log('Solution deleted successfully');
  }
}

assert {
  res.status: eq 204
}

tests {
  test("Solution deleted successfully", function() {
    expect(res.getStatus()).to.equal(204);
  });
}
