meta {
  name: DELETE Delete Provider Registration - Success
  type: http
  seq: 6
  tags: [
    destructive
  ]
}

delete {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/providers/{{createdProviderRegistrationId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 204
}

script:pre-request {
  const registrationId = bru.getVar('createdProviderRegistrationId');
  if (!registrationId) {
    throw new Error('No provider registration ID found. Run "POST Create Provider Registration - Success" first.');
  }
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 204) {
    console.log('Provider registration deleted:', bru.getVar('createdProviderRegistrationId'));
  }
}

tests {
  test("Provider registration deleted successfully", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  # Delete Provider Registration - Success
  
  Deletes a provider registration by its ID.
  
  ## Prerequisites
  
  - Run "POST Create Provider Registration - Success" first to set `createdProviderRegistrationId`
  
  ## Expected Response
  
  - Status: 204 No Content
  
  ## What This Tests
  
  - Provider registration deletion by ID
  - Successful cleanup returns 204 with no body
}
