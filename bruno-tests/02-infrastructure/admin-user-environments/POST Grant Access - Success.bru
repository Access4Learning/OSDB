meta {
  name: POST Grant Access - Success
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/admin-users/{{createdAdminUserId}}/environments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{createdEnvironmentId}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.userId: isDefined
  res.body.environmentId: isDefined
  res.body.grantedAt: isDefined
}

script:pre-request {
  const adminUserId = bru.getVar('createdAdminUserId');
  if (!adminUserId) {
    throw new Error('No admin user ID found. Run "POST Create Admin User - Success" first.');
  }
  
  const envId = bru.getVar('createdEnvironmentId');
  if (!envId) {
    throw new Error('No environment ID found. Run "POST Create Environment - Success" first.');
  }
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('createdAccessId', data.id);
    console.log('Granted environment access:', data.id);
  }
}

tests {
  test("Environment access granted successfully", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response contains access association data", function() {
    const data = res.getBody();
    expect(data).to.have.property('id');
    expect(data).to.have.property('userId');
    expect(data).to.have.property('environmentId');
    expect(data).to.have.property('applicationName');
    expect(data).to.have.property('grantedAt');
  });
  
  test("Association references correct user and environment", function() {
    const data = res.getBody();
    const adminUserId = bru.getVar('createdAdminUserId');
    const envId = bru.getVar('createdEnvironmentId');
    expect(data.userId).to.equal(adminUserId);
    expect(data.environmentId).to.equal(envId);
  });
  
  test("Association ID is valid UUID", function() {
    const data = res.getBody();
    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
    expect(data.id).to.match(uuidRegex);
  });
}

docs {
  # Grant Environment Access - Success
  
  Grants an admin user access to an environment.
  
  ## Prerequisites
  
  - An admin user must exist (createdAdminUserId from admin-users tests)
  - An environment must exist (createdEnvironmentId)
  - The environment must belong to the same domain+solution as the admin user
  
  ## Expected Response
  
  - Status: 201 Created
  - Body: Association details with id, userId, environmentId, applicationName, grantedAt
  
  ## What This Tests
  
  - Successful environment access grant (Requirement 2.2)
  - Response contains all expected fields
  - Association correctly links user to environment
}
