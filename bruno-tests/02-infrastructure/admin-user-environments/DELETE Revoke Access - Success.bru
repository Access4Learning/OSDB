meta {
  name: DELETE Revoke Access - Success
  type: http
  seq: 4
}

delete {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/admin-users/{{createdAdminUserId}}/environments/{{createdEnvironmentId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 204
}

script:pre-request {
  const adminUserId = bru.getVar('createdAdminUserId');
  if (!adminUserId) {
    throw new Error('No admin user ID found. Run "POST Create Admin User - Success" first.');
  }
  
  const envId = bru.getVar('createdEnvironmentId');
  if (!envId) {
    throw new Error('No environment ID found. Run "POST Grant Access - Success" first.');
  }
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 204) {
    bru.setVar('createdAccessId', null);
    console.log('Environment access revoked successfully');
  }
}

tests {
  test("Environment access revoked successfully", function() {
    expect(res.getStatus()).to.equal(204);
  });
  
  test("No response body", function() {
    const body = res.getBody();
    expect(body).to.be.oneOf([null, undefined, '']);
  });
}

docs {
  # Revoke Environment Access - Success
  
  Revokes an admin user's access to an environment.
  
  ## Prerequisites
  
  - Access must have been granted first (run "POST Grant Access - Success")
  
  ## Expected Response
  
  - Status: 204 No Content
  - No response body
  
  ## What This Tests
  
  - Successful access revocation (Requirement 2.9)
  - Association record is deleted
}
