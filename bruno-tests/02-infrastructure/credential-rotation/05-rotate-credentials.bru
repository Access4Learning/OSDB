meta {
  name: 05 Rotate Credentials
  type: http
  seq: 5
}

post {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/environments/{{rotTestEnvId}}/rotate-credentials
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "sessionToken": "my-custom-token-{{$timestamp}}",
    "sharedSecret": "my-custom-secret-for-testing"
  }
}

assert {
  res.status: eq 200
  res.body.id: isDefined
  res.body.sessionToken: isDefined
  res.body.sharedSecret: isDefined
  res.body.rotatedAt: isDefined
}

script:pre-request {
  // Authenticate with CURRENT credentials (proving ownership)
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, {
    sessionToken: bru.getVar('rotTestSessionToken'),
    sharedSecret: bru.getVar('rotTestSharedSecret')
  });
}

script:post-response {
  if (res.getStatus() === 200) {
    const data = res.getBody();
    // Store OLD credentials for the "should fail" test
    bru.setVar('rotTestOldSessionToken', bru.getVar('rotTestSessionToken'));
    bru.setVar('rotTestOldSharedSecret', bru.getVar('rotTestSharedSecret'));
    // Update to NEW credentials
    bru.setVar('rotTestSessionToken', data.sessionToken);
    bru.setVar('rotTestSharedSecret', data.sharedSecret);
    console.log('Credentials rotated!');
    console.log('  New Session Token:', data.sessionToken);
    console.log('  New Shared Secret:', data.sharedSecret);
    console.log('  Rotated At:', data.rotatedAt);
  }
}

tests {
  test("Credentials rotated successfully", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.sessionToken).to.exist;
    expect(data.sharedSecret).to.exist;
    expect(data.rotatedAt).to.exist;
    // Should match what we requested
    expect(data.sessionToken).to.contain('my-custom-token-');
    expect(data.sharedSecret).to.equal('my-custom-secret-for-testing');
  });
}
