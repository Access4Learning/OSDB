meta {
  name: 06 GET Environment (New Credentials)
  type: http
  seq: 6
}

get {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/environments/{{rotTestEnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
  res.body.id: isDefined
}

script:pre-request {
  // Authenticate with the NEW rotated credentials
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, {
    sessionToken: bru.getVar('rotTestSessionToken'),
    sharedSecret: bru.getVar('rotTestSharedSecret')
  });
}

tests {
  test("Can GET environment with NEW credentials", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data.id).to.equal(bru.getVar('rotTestEnvId'));
    console.log('Successfully authenticated with NEW credentials after rotation');
  });
}
