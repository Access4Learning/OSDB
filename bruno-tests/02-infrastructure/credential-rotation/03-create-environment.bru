meta {
  name: 03 Create Environment
  type: http
  seq: 3
}

post {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environment": {
      "consumerName": "RotationTestApp",
      "type": "BROKERED"
    }
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
  res.body.environment.sessionToken: isDefined
  res.body.environment.sharedSecret: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody().environment;
    bru.setVar('rotTestEnvId', data.id);
    bru.setVar('rotTestSessionToken', data.sessionToken);
    bru.setVar('rotTestSharedSecret', data.sharedSecret);
    console.log('Created environment:', data.id);
    console.log('Session Token:', data.sessionToken);
    console.log('Shared Secret:', data.sharedSecret);
  }
}

tests {
  test("Environment created with credentials", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().environment;
    expect(data.sessionToken).to.exist;
    expect(data.sharedSecret).to.exist;
  });
}
