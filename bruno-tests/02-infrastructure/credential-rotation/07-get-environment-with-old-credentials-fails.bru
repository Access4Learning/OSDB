meta {
  name: 07 GET Environment (Old Credentials FAIL)
  type: http
  seq: 7
}

get {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/environments/{{rotTestEnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: in [401, 403]
}

script:pre-request {
  // Authenticate with the OLD (now invalid) credentials
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, {
    sessionToken: bru.getVar('rotTestOldSessionToken'),
    sharedSecret: bru.getVar('rotTestOldSharedSecret')
  });
}

tests {
  test("OLD credentials are rejected after rotation", function() {
    const status = res.getStatus();
    expect(status).to.be.oneOf([401, 403]);
    console.log('Old credentials correctly rejected with status:', status);
  });
}
