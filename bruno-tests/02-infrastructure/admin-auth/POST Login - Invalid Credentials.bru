meta {
  name: POST Login - Invalid Credentials
  type: http
  seq: 2
}

post {
  url: {{gatewayUrl}}/admin-users/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{adminUserUsername}}",
    "password": "wrong-password-definitely-invalid",
    "domainUuid": "{{adminUserDomainUuid}}",
    "solutionUuid": "{{adminUserSolutionUuid}}"
  }
}

assert {
  res.status: eq 401
}

script:pre-request {
  const username = bru.getVar('adminUserUsername');
  if (!username) {
    throw new Error('No admin user credentials found. Run admin user creation tests first.');
  }
}

tests {
  test("Invalid credentials return 401", function() {
    expect(res.getStatus()).to.equal(401);
  });
  
  test("Error message is generic (no information leakage)", function() {
    const data = res.getBody();
    // Should not reveal whether username or password was wrong
    const bodyStr = JSON.stringify(data).toLowerCase();
    expect(bodyStr).to.not.include('username not found');
    expect(bodyStr).to.not.include('password incorrect');
    expect(bodyStr).to.not.include('user does not exist');
  });
  
  test("Response does not contain session token", function() {
    const data = res.getBody();
    expect(data).to.not.have.property('sessionToken');
  });
}

docs {
  # Login - Invalid Credentials
  
  Attempts login with an incorrect password.
  
  ## Expected Response
  
  - Status: 401 Unauthorized
  - Generic error message (no information leakage about which field was wrong)
  
  ## What This Tests
  
  - Authentication rejection with wrong password
  - No information leakage (doesn't reveal if username exists)
  - Requirements: 3.2
}
