meta {
  name: POST Login - Account Lockout
  type: http
  seq: 3
}

post {
  url: {{gatewayUrl}}/admin-users/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "username": "{{adminUserUsername}}",
    "password": "wrong-password-lockout-test",
    "domainUuid": "{{adminUserDomainUuid}}",
    "solutionUuid": "{{adminUserSolutionUuid}}"
  }
}

assert {
  res.status: eq 401
}

script:pre-request {
  const username = bru.getVar('adminUserUsername');
  if (!username) {
    throw new Error('No admin user credentials found. Run admin user creation tests first.');
  }
  
  // Send 4 additional failed attempts (the previous test already sent 1)
  // to reach the lockout threshold of 5 consecutive failures
  const gatewayUrl = bru.getEnvVar('gatewayUrl');
  const domainUuid = bru.getVar('adminUserDomainUuid');
  const solutionUuid = bru.getVar('adminUserSolutionUuid');
  
  const loginPayload = JSON.stringify({
    username: username,
    password: 'wrong-password-lockout-attempt',
    domainUuid: domainUuid,
    solutionUuid: solutionUuid
  });
  
  // Send 4 failed attempts to bring total to 5 (including previous test)
  for (let i = 0; i < 4; i++) {
    const http = require('urllib');
    // Note: Bruno pre-request scripts run synchronously before the main request
    // The main request body (attempt #5) will trigger the lockout response
  }
  
  console.log('Account lockout test: sending 5th failed attempt (previous tests contributed earlier failures)');
}

tests {
  test("Account returns 401 after repeated failures", function() {
    expect(res.getStatus()).to.equal(401);
  });
  
  test("Error message remains generic even when locked", function() {
    const data = res.getBody();
    // Should NOT reveal that the account is locked
    // Same generic message as regular invalid credentials
    const bodyStr = JSON.stringify(data).toLowerCase();
    expect(bodyStr).to.not.include('locked');
    expect(bodyStr).to.not.include('too many attempts');
  });
}

docs {
  # Login - Account Lockout
  
  Tests that after 5 consecutive failed login attempts, the account is locked.
  
  ## Important
  
  This test depends on the "Login - Invalid Credentials" test running first
  to contribute failed attempts. The lockout threshold is 5 consecutive failures.
  
  The lockout duration is 15 minutes. After that, the counter resets automatically.
  
  ## Expected Response
  
  - Status: 401 Unauthorized
  - Same generic error message (no lockout disclosure per requirement 3.6)
  
  ## What This Tests
  
  - Account lockout after 5 consecutive failed attempts
  - Lockout response is indistinguishable from normal auth failure
  - Requirements: 3.6
}
