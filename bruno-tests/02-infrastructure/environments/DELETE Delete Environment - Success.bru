meta {
  name: DELETE Delete Environment - Success
  type: http
  seq: 5
}

delete {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/environments/{{createdEnvironmentId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 204
}

script:pre-request {
  // Verify we have an environment ID
  const envId = bru.getVar('createdEnvironmentId');
  if (!envId) {
    throw new Error('No environment ID found. Run "Create Environment - Success" first.');
  }
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, "admin");
}

script:post-response {
  // Clear the stored environment ID
  if (res.getStatus() === 204) {
    bru.setVar('createdEnvironmentId', null);
    console.log('Environment deleted successfully');
  }
}

tests {
  test("Environment deleted successfully", function() {
    expect(res.getStatus()).to.equal(204);
  });
  
  test("No response body", function() {
    const body = res.getBody();
    expect(body).to.be.oneOf([null, undefined, '']);
  });
}

docs {
  # Delete Environment - Success
  
  Deletes an environment by its ID.
  
  ## Prerequisites
  
  - An environment must be created first
  - The environment ID is stored in `createdEnvironmentId` variable
  
  ## Expected Response
  
  - Status: 204 No Content
  - No response body
  
  ## What This Tests
  
  - Delete operation with authentication
  - Environment is removed from the system
  - Session token is revoked
  
  ## Important
  
  After deletion, the environment's session token can no longer be used for authentication.
}
