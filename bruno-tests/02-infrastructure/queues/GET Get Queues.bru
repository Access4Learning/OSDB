meta {
  name: GET Get Queues
  type: http
  seq: 2
  tags: [
    nondestructive
  ]
}

get {
  url: {{gatewayUrl}}/{{createdDomainId}}/{{createdSolutionId}}/queues
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.name: isDefined
  res.body.ownerId: isDefined
}

script:pre-request {
  const envId = bru.getVar('createdEnvironmentId');
  if (!envId) {
    throw new Error('No environment ID found. Run "Create Environment - Success" first.');
  }
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'created' });
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('createdQueueId', data.id);
    bru.setVar('createdQueueName', data.name);
    console.log('Created queue:', data.id, data.name);
  }
}

tests {
  test("Queue created successfully", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("Response contains queue data", function() {
    const data = res.getBody();
    expect(data).to.have.property('id');
    expect(data).to.have.property('name');
    expect(data).to.have.property('ownerId');
    expect(data).to.have.property('maxRetries');
    expect(data).to.have.property('retryDelayMs');
  });
  
  test("Queue owner matches created environment", function() {
    const data = res.getBody();
    const expectedOwnerId = bru.getVar('createdEnvironmentId');
    expect(data.ownerId).to.equal(expectedOwnerId);
  });
  
  test("Queue ID is valid UUID", function() {
    const data = res.getBody();
    const uuidRegex = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;
    expect(data.id).to.match(uuidRegex);
  });
}

docs {
  # Create Queue - Success
  
  Creates a new queue owned by the environment created in "POST Create Environment - Success".
  
  ## Prerequisites
  
  - Run "POST Create Environment - Success" first to set `createdEnvironmentId`
  - Update .env with the created environment's sessionToken and sharedSecret
  
  ## Expected Response
  
  - Status: 201 Created
  - Body: Created queue with generated ID, name, ownerId, and configuration
  
  ## What This Tests
  
  - Queue creation with authentication
  - Queue is associated with the correct owner environment
  - Queue ID is generated as a valid UUID
  - Default retry configuration is applied
}
