meta {
  name: 05-Create Provider ACL for TESTOBJECT1s
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/{{evtDomainId}}/{{evtSolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{evtProviderEnvId}}",
    "serviceName": "TESTOBJECT1s",
    "zoneId": "{{evtZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "PROVIDE",
    "accessLevel": "APPROVED"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('evtProviderAclId', data.id);
    console.log('Created PROVIDE ACL for ObjectProvider:', data.id);
  }
}

assert {
  res.status: eq 201
}

tests {
  test("Provider ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

