meta {
  name: 08b-Create Consumer2 Queue
  type: http
  seq: 13
}

post {
  url: {{gatewayUrl}}/{{evtDomainId}}/{{evtSolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "DEFAULTQUEUE",
      "ownerId": "{{evtConsumer2EnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'evtConsumer2' });
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar('evtConsumer2QueueId', data.queue.id);
    console.log('Created Consumer2 queue:', data.queue.id);
  }
}

assert {
  res.status: eq 201
  res.body.queue.id: isDefined
}

tests {
  test("Consumer2 queue created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().queue.name).to.equal('DEFAULTQUEUE');
  });
}

