meta {
  name: 04-Create ObjectProvider Environment
  type: http
  seq: 5
}

post {
  url: {{gatewayUrl}}/{{evtDomainId}}/{{evtSolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environment": {
      "consumerName": "ObjectProvider-{{$timestamp}}",
      "type": "BROKERED"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody().environment;
    bru.setVar('evtProviderEnvId', data.id);
    bru.setVar('evtProviderSessionToken', data.sessionToken);
    bru.setVar('evtProviderSharedSecret', data.sharedSecret);
    console.log('Created ObjectProvider environment:', data.id);
    
    // Extract events connector URL
    if (data.infrastructureServices && data.infrastructureServices.infrastructureService) {
      const services = data.infrastructureServices.infrastructureService;
      const eventsService = services.find(s => s.name === 'EVENTS_CONNECTOR');
      if (eventsService) {
        bru.setVar('evtProviderEventsUrl', eventsService.value);
        console.log('Provider Events URL:', eventsService.value);
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
  res.body.environment.sessionToken: isDefined
}

tests {
  test("ObjectProvider environment created", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().environment;
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
  });
}

