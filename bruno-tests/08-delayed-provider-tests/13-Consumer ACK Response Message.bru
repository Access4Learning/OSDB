meta {
  name: 13-Consumer ACK Response Message
  type: http
  seq: 15
}

get {
  url: {{gatewayUrl}}/{{dlyDomainId}}/{{dlySolutionId}}/queues/{{dlyConsumerQueueId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  connectionId: dlyConsumer
  X-Environment-Id: {{dlyConsumerEnvId}}
  deleteMessageId: {{dlyConsumerLastMessageId}}
}

assert {
  res.status: in [200, 204]
}

script:pre-request {
  const messageId = bru.getVar('dlyConsumerLastMessageId');
  if (!messageId) {
    throw new Error('No messageId to ACK. Run step 12 first and ensure a message was delivered.');
  }
  
  console.log('ACKing messageId:', messageId);
  
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'dlyConsumer' });
}

script:post-response {
  const status = res.getStatus();
  
  if (status === 200) {
    const messageId = res.getHeaders()?.messageid;
    if (messageId) {
      bru.setVar('dlyConsumerLastMessageId', messageId);
      console.log('Next message ID:', messageId);
    }
    console.log('Next payload:', JSON.stringify(res.getBody(), null, 2));
  } else if (status === 204) {
    console.log('Message ACKed. Queue is now empty.');
    bru.setVar('dlyConsumerLastMessageId', '');
  }
}

tests {
  test("ACK succeeds", function() {
    expect([200, 204]).to.include(res.getStatus());
  });
  
  test("Queue should be empty after ACK (204)", function() {
    // We only sent one DELAYED request, so after ACK the queue should be drained
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  # Consumer ACKs the Response Message
  
  Acknowledges the delayed response message using the SIF "Get Next and Pop"
  pattern. The deleteMessageId matrix parameter is set to the messageid from
  the previous GET response (step 12).
  
  After ACK, the queue should be empty (204) since we only sent one request.
  
  ## Prerequisites
  
  - Message delivered in step 12 (status 200 with messageid header)
}
