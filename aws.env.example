# =============================================================================
# AWS Deployment Configuration
# =============================================================================
#
# Copy this file to aws.env and fill in the empty values:
#
#     cp aws.env.example aws.env
#
# aws.env is gitignored — never commit real values.
#
# Variables with a value shown below are safe defaults; override them only if
# your setup differs. Variables left empty are specific to your AWS account and
# have no sensible default: the scripts fail fast with a clear message rather
# than guessing, so they can never act against the wrong account.
#
# Each entry records where to find the value and which scripts read it.
#
# Every variable can also be passed directly as a script parameter, e.g.
#     .\build-and-push.ps1 -AccountId 123456789012 -Region us-east-1
#
# -----------------------------------------------------------------------------
# AWS account and region
# -----------------------------------------------------------------------------

# Your 12-digit AWS account ID.
#   Find it:  aws sts get-caller-identity --query Account --output text
#             (or AWS Console, account menu, top right)
#   Used by:  build-and-push.ps1, build-and-push-images.ps1
AWS_ACCOUNT_ID=

# Region your resources live in.
#   Find it:  aws configure get region
#   Used by:  build-and-push.ps1, build-and-push-images.ps1, deploy-admin-console.ps1
AWS_REGION=us-east-1

# Named AWS CLI profile to authenticate with. Use "default" if you have not
# configured named profiles. Profiles using SSO are logged in automatically by
# build-and-push-images.ps1 when the session has expired.
#   Find it:  aws configure list-profiles
#   Used by:  build-and-push-images.ps1, deploy-admin-console.ps1
AWS_PROFILE=default

# -----------------------------------------------------------------------------
# Container images (ECR and ECS)
# -----------------------------------------------------------------------------

# Namespace prefix for the service repositories in ECR. Images are pushed to
# <account>.dkr.ecr.<region>.amazonaws.com/<prefix>/<service>, so a prefix of
# "osdb" gives repositories like osdb/gateway and osdb/queue-service.
#   Find it:  aws ecr describe-repositories --query "repositories[].repositoryName"
#   Used by:  build-and-push.ps1, build-and-push-images.ps1
ECR_REPO_PREFIX=osdb

# ECS cluster that runs the services. Used to force a new deployment after new
# images are pushed.
#   Find it:  aws ecs list-clusters
#   Used by:  build-and-push-images.ps1
ECS_CLUSTER_NAME=osdb-cluster

# -----------------------------------------------------------------------------
# Admin console deployment
# -----------------------------------------------------------------------------

# S3 bucket the built admin console is uploaded to.
#   Find it:  aws s3 ls
#   Used by:  deploy-admin-console.ps1
ADMIN_CONSOLE_BUCKET=

# CloudFront distribution serving that bucket. Its cache is invalidated after
# each upload, so a deployment is visible immediately.
#   Find it:  aws cloudfront list-distributions \
#               --query "DistributionList.Items[].{Id:Id,Domain:DomainName}"
#   Used by:  deploy-admin-console.ps1
CLOUDFRONT_DISTRIBUTION_ID=

# -----------------------------------------------------------------------------
# Broker endpoint and admin credentials
# -----------------------------------------------------------------------------

# Public URL of the deployed broker gateway. This is what the admin console and
# the load tests talk to. Include the scheme and no trailing slash — for example
# https://d1234abcd.cloudfront.net or http://my-alb.us-east-1.elb.amazonaws.com
#   Find it:  the CloudFront domain above, or the ALB DNS name:
#             aws elbv2 describe-load-balancers --query "LoadBalancers[].DNSName"
#   Used by:  deploy-admin-console.ps1, experimental-admin-console/start-aws.ps1,
#             experimental-admin-console/startTranscript.ps1,
#             gatling-load-tests/run-aws.ps1
GATEWAY_URL=

# Admin credentials for the deployed broker. These are the bootstrap admin
# environment's session token and shared secret, not an AWS credential. They are
# created when the broker is first provisioned and stored in Secrets Manager.
#   Find it:  aws secretsmanager get-secret-value \
#               --secret-id osdb/admin/bootstrap-credentials
#   Used by:  gatling-load-tests/run-aws.ps1
ADMIN_SESSION_TOKEN=
ADMIN_SHARED_SECRET=
