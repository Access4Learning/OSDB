meta {
  name: 14 Delete Zone Non-Admin
  type: http
  seq: 14
}

delete {
  url: {{gatewayUrl}}/{{sec01DomainId}}/{{sec01SolutionId}}/zones/{{sec01DeleteTestZoneId}}
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

script:pre-request {
  const auth = require('./common/auth.js');
  // Authenticate directly as the non-admin (BROKERED) consumer environment created in step 06.
  // Zone deletion must be rejected for non-admin callers with 403.
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec01Consumer' });
}

script:post-response {
  const status = res.getStatus();
  if (status !== 403) {
    throw new Error(
      '01-environment-registration/14-delete-zone-non-admin FAILED: expected 403, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  console.log('✓ Non-admin zone deletion correctly rejected with 403');
}

assert {
  res.status: eq 403
}

tests {
  test("Non-admin zone deletion returns 403 Forbidden", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("Zone still exists after rejected deletion", function() {
    const zoneId = bru.getVar('sec01DeleteTestZoneId');
    expect(zoneId).to.be.a('string');
    expect(zoneId.length).to.be.greaterThan(0);
  });
}

docs {
  ## Summary

  Attempts to delete a zone using a non-admin environment fingerprint and verifies
  the request is rejected with HTTP 403 Forbidden.

  ## Rationale

  Zone deletion is an administrative operation. A non-admin environment (the BROKERED
  consumer created in step 06) authenticating with its own credentials must be denied
  access. This test confirms the authorization guard works correctly.

  Note: impersonation via `X-Run-As-Environment` only accepts a UUID or the literal
  `broker-services` (the gateway returns 400 PROXY_005 for any other value), so a
  non-admin caller is simulated by authenticating directly as the consumer environment
  rather than via run-as impersonation.

  ## Expected Result

  - HTTP 403 Forbidden
  - Zone remains intact for subsequent deletion tests (15–18)
}
