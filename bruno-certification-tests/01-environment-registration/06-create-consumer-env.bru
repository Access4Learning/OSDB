meta {
  name: 06 Create Consumer Environment
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/{{sec01DomainId}}/{{sec01SolutionId}}/environments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "applicationName": "CertConsumer-EnvReg-{{$timestamp}}",
    "type": "BROKERED",
    "defaultZoneId": "{{sec01ZoneId}}"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec01Admin' });

  const zoneId = bru.getVar('sec01ZoneId');
  if (!zoneId) {
    throw new Error(
      '01-environment-registration/03-create-consumer-env: Missing sec01ZoneId. ' +
      'Step 01-setup-zone must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '01-environment-registration/03-create-consumer-env FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec01ConsumerEnvId', data.id);
  bru.setVar('sec01ConsumerSessionToken', data.sessionToken);
  bru.setVar('sec01ConsumerSharedSecret', data.sharedSecret);
  console.log('✓ Consumer environment created: ' + data.id);
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.sessionToken: isDefined
}

tests {
  test("Consumer environment created with type BROKERED", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
  });
}

docs {
  ## Summary

  Registers a consumer environment with type BROKERED in the test zone.

  ## Rationale

  A BROKERED environment routes all communication through the broker's connector
  endpoints. Consumers use BROKERED environments to send requests, subscribe to events,
  and manage queues. This is the most common environment type for SIF applications and
  should return the full set of 8 infrastructure services.

  ## Expected Result

  - HTTP 201 Created
  - Response body contains `id`, `sessionToken`, `sharedSecret`
  - `sec01ConsumerEnvId` variable stored for subsequent tests
}
