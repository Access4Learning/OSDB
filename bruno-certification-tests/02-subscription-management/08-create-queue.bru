meta {
  name: 08 Create Queue
  type: http
  seq: 9
}

post {
  url: {{gatewayUrl}}/{{sec02DomainId}}/{{sec02SolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "cert-sec02-queue-{{$timestamp}}",
      "ownerId": "{{sec02ConsumerEnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

assert {
  res.status: eq 201
  res.body.queue.id: isDefined
  res.body.queue.name: isDefined
  res.body.queue.ownerId: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec02Consumer' });

  const consumerEnvId = bru.getVar('sec02ConsumerEnvId');
  if (!consumerEnvId) {
    throw new Error(
      '02-subscription-management/05-create-queue: Missing sec02ConsumerEnvId. ' +
      'Step 03-create-consumer-env must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '02-subscription-management/05-create-queue FAILED: expected 200-201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec02QueueId', data.queue.id);

  console.log('✓ Queue created: ' + data.queue.id + ' (' + data.queue.name + ')');
}

docs {
  ## Summary

  Creates a queue owned by the consumer environment for receiving subscription messages.

  ## Rationale

  A queue is the consumer's inbox. Subscriptions bind to a queue, directing the broker
  to deposit matching messages (events or delayed requests) into it. Without a queue,
  subscriptions cannot be created.

  ## Expected Result

  - HTTP 201 Created
  - Queue ID stored in `sec02QueueId`
  - Queue owned by the consumer environment (`sec02ConsumerEnvId`)
}
