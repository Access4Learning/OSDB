meta {
  name: 13 Invalid ACL Subscription
  type: http
  seq: 14
}

post {
  url: {{gatewayUrl}}/{{sec02DomainId}}/{{sec02SolutionId}}/subscriptions/subscription
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  serviceType: OBJECT
}

body:json {
  {
    "subscription": {
      "queueId": "{{sec02QueueId}}",
      "aclEntryId": "00000000-0000-0000-0000-000000000000",
      "messageType": "EVENT"
    }
  }
}

assert {
  res.status: eq 400
  res.body.error.id: isDefined
  res.body.error.code: isDefined
  res.body.error.message: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec02Consumer' });

  const queueId = bru.getVar('sec02QueueId');
  if (!queueId) {
    throw new Error('sec02QueueId not set. Run 05-create-queue first.');
  }
}

tests {
  test("Subscription creation rejected with 400 for an unresolvable ACL reference", function() {
    // D7 (2.16): POST /subscriptions/subscription declares no 404. A caller-supplied aclEntryId that does not resolve is a malformed reference, not a missing resource, so the broker returns 400. "Caller holds no matching grant" is the separate 403 case.
    expect(res.getStatus()).to.equal(400);
  });

  test("Error response contains message field", function() {
    const data = res.getBody();
    expect(data).to.have.property('error');
    expect(data.error).to.have.property('message');
    expect(data.error.message).to.be.a('string');
    expect(data.error.message.length).to.be.greaterThan(0);
  });

  test("Error response contains error code", function() {
    const data = res.getBody();
    expect(data.error).to.have.property('code');
    expect(data.error).to.have.property('subCode');
  });

  test("Error response scope is BROKER", function() {
    const data = res.getBody();
    expect(data.error).to.have.property('scope');
    expect(data.error.scope).to.equal('BROKER');
  });

  test("No subscription was created (list unchanged)", function() {
    // The subscription list should not have grown from this failed attempt; implied by
    // the 400 rejection.
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  ## Summary

  Attempts to create a subscription with a nonexistent ACL entry ID and verifies
  the broker rejects the request with 400.

  ## Rationale

  Subscriptions are bound to ACL entries. If the referenced ACL entry does not exist,
  the broker cannot resolve the service name, zone, and context. A compliant broker
  must reject such requests with a 400 error rather than creating an invalid subscription.
  400 and not 404: this operation declares no 404, and an aclEntryId that does not resolve
  is a malformed reference rather than a missing resource.
  This prevents orphaned subscriptions that can never receive messages.

  ## Expected Result

  - HTTP 400 Bad Request
  - Error response body contains: message (describing the ACL entry was not found),
    code (error code), and scope ("BROKER")
  - No subscription is created
}
