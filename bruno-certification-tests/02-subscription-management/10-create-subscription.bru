meta {
  name: 10 Create Subscription
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{sec02DomainId}}/{{sec02SolutionId}}/subscriptions/subscription
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  serviceType: OBJECT
}

body:json {
  {
    "subscription": {
      "queueId": "{{sec02QueueId}}",
      "aclEntryId": "{{sec02ConsumerAclId}}",
      "messageType": "EVENT"
    }
  }
}

assert {
  res.status: eq 201
  res.body.subscription.id: isDefined
  res.body.subscription.queueId: isDefined
  res.body.subscription.serviceName: isDefined
  res.body.subscription.zoneId: isDefined
  res.body.subscription.messageType: isDefined
  res.body.subscription.createdAt: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec02Consumer' });

  const queueId = bru.getVar('sec02QueueId');
  if (!queueId) {
    throw new Error('sec02QueueId not set. Run 05-create-queue first.');
  }

  const aclId = bru.getVar('sec02ConsumerAclId');
  if (!aclId) {
    throw new Error('sec02ConsumerAclId not set. Run 04-create-acls first.');
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '02-subscription-management/10-create-subscription FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().subscription;
  bru.setVar('sec02SubscriptionId', data.id);

  console.log('✓ Subscription created: ' + data.id);
  console.log('  serviceName: ' + data.serviceName);
  console.log('  zoneId: ' + data.zoneId);
  console.log('  contextId: ' + (data.contextId || 'null'));
  console.log('  messageType: ' + data.messageType);
}

tests {
  test("Subscription created with 201 status", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response contains subscription wrapper key", function() {
    const body = res.getBody();
    expect(body).to.have.property('subscription');
  });

  test("Response contains subscription ID", function() {
    const data = res.getBody().subscription;
    expect(data).to.have.property('id');
    expect(data.id).to.be.a('string');
  });

  test("Response contains queueId matching request", function() {
    const data = res.getBody().subscription;
    const expectedQueueId = bru.getVar('sec02QueueId');
    expect(data.queueId).to.equal(expectedQueueId);
  });

  test("Response contains serviceName resolved from ACL entry", function() {
    const data = res.getBody().subscription;
    expect(data).to.have.property('serviceName');
    expect(data.serviceName).to.equal('StudentPersonal');
  });

  test("Response contains zoneId resolved from ACL entry", function() {
    const data = res.getBody().subscription;
    expect(data).to.have.property('zoneId');
    expect(data.zoneId).to.be.a('string');
  });

  test("Response contains messageType matching request", function() {
    const data = res.getBody().subscription;
    expect(data.messageType).to.equal('EVENT');
  });

  test("Response contains createdAt timestamp", function() {
    const data = res.getBody().subscription;
    expect(data).to.have.property('createdAt');
    expect(data.createdAt).to.be.a('string');
  });
}

docs {
  ## Summary

  Creates a new EVENT subscription binding the consumer's queue to the StudentPersonal
  event stream via the SUBSCRIBE ACL entry.

  ## Rationale

  Subscription creation is the core operation that activates event delivery for a consumer.
  A compliant broker must resolve the ACL entry to extract service name, zone, and context,
  then return all resolved fields on the subscription object. This verifies that the
  broker correctly binds queue → ACL → event stream.

  Per SIF 3.7, the request uses the singular resource URL (/subscriptions/subscription)
  and wraps the payload in a {"subscription": {...}} envelope.

  ## Expected Result

  - HTTP 201 Created
  - Response body wrapped in {"subscription": {...}} envelope
  - Subscription contains: id, queueId, serviceName, zoneId, contextId, messageType, createdAt
  - serviceName is "StudentPersonal" (resolved from ACL entry)
  - messageType is "EVENT" (as requested)
  - queueId matches the queue created in setup
}
