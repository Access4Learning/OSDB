meta {
  name: 06 Create Consumer Environment
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/{{sec02DomainId}}/{{sec02SolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "applicationName": "CertConsumer-SubMgmt-{{$timestamp}}",
    "type": "BROKERED",
    "defaultZoneId": "{{sec02ZoneId}}"
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
  res.body.environment.sessionToken: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec02Admin' });

  const zoneId = bru.getVar('sec02ZoneId');
  if (!zoneId) {
    throw new Error(
      '02-subscription-management/03-create-consumer-env: Missing sec02ZoneId. ' +
      'Step 01-setup-zone must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '02-subscription-management/03-create-consumer-env FAILED: expected 200-201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().environment;
  bru.setVar('sec02ConsumerEnvId', data.id);
  bru.setVar('sec02ConsumerSessionToken', data.sessionToken);
  bru.setVar('sec02ConsumerSharedSecret', data.sharedSecret);

  console.log('âœ“ Consumer environment created: ' + data.id);
}

docs {
  ## Summary

  Creates a BROKERED consumer environment for subscription management tests.

  ## Rationale

  A consumer environment is needed to own a queue and create subscriptions.
  BROKERED type environments receive messages through the broker's queue system
  rather than directly from providers.

  ## Expected Result

  - HTTP 201 Created
  - Consumer environment ID stored in `sec02ConsumerEnvId`
  - Consumer credentials stored in `sec02ConsumerSessionToken` and `sec02ConsumerSharedSecret`
}
