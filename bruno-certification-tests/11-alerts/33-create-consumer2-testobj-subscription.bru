meta {
  name: 33 Create Consumer 2 Subscription for TestObjects
  type: http
  seq: 30
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/subscriptions/subscription
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "subscription": {
      "queueId": "{{sec11Consumer2QueueId}}",
      "aclEntryId": "{{sec11Consumer2TestObjSubAclId}}",
      "messageType": "EVENT"
    }
  }
}

assert {
  res.status: eq 201
  res.body.subscription.id: isDefined
  res.body.subscription.queueId: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Consumer2' });
  
  const queueId = bru.getVar('sec11Consumer2QueueId');
  const aclId = bru.getVar('sec11Consumer2TestObjSubAclId');
  if (!queueId || !aclId) {
    throw new Error(
      '11-alerts/33: Missing sec11Consumer2QueueId or sec11Consumer2TestObjSubAclId. ' +
      'Steps 29 and 24 must run first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '11-alerts/33 FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  
  const data = res.getBody().subscription;
  bru.setVar('sec11Consumer2TestObjSubId', data.id);
  console.log('✓ Consumer 2 TestObjects subscription created: ' + data.id);
}

tests {
  test("Consumer 2 TestObjects subscription created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().subscription.id).to.exist;
  });
  
  test("Subscription references Consumer 2 queue", function() {
    expect(res.getBody().subscription.queueId).to.equal(bru.getVar('sec11Consumer2QueueId'));
  });
}

docs {
  ## Summary
  Creates a subscription binding Consumer 2's queue to TestObjects events.
  
  ## Rationale
  Consumer 2 subscribes to TestObjects EVENT messages so it also receives the broadcast
  UPDATE event from the Provider. This proves event fan-out works to multiple subscribers
  while the directed alert later targets only the originator.
  
  ## Expected Result
  - HTTP 201 → `sec11Consumer2TestObjSubId` stored
}
