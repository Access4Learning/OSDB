meta {
  name: 23 Create Consumer 1 SUBSCRIBE ACL for TestObjects
  type: http
  seq: 20
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec11ConsumerEnvId}}",
    "serviceName": "TestObjects",
    "zoneId": "{{sec11ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "SUBSCRIBE",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Admin' });
  
  const consumerEnvId = bru.getVar('sec11ConsumerEnvId');
  if (!consumerEnvId) {
    throw new Error(
      '11-alerts/23: Missing sec11ConsumerEnvId. Step 06 must run first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '11-alerts/23 FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  
  bru.setVar('sec11Consumer1TestObjSubAclId', res.getBody().id);
  console.log('✓ Consumer 1 SUBSCRIBE ACL for TestObjects: ' + res.getBody().id);
}

tests {
  test("Consumer 1 SUBSCRIBE ACL for TestObjects created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.exist;
  });
}

docs {
  ## Summary
  Creates a SUBSCRIBE ACL for TestObjects on Consumer 1.
  
  ## Rationale
  Consumer 1 needs SUBSCRIBE access to TestObjects so it can receive events published
  by the Provider. This subscription will deliver the UPDATE event that Consumer 1
  later references when creating a directed alert.
  
  ## Expected Result
  - HTTP 201 → `sec11Consumer1TestObjSubAclId` stored
}
