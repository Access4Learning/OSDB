meta {
  name: 32 Create Consumer 1 Subscription for alerts
  type: http
  seq: 29
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/subscriptions/subscription
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "subscription": {
      "queueId": "{{sec11Consumer1QueueId}}",
      "aclEntryId": "{{sec11Consumer1AlertSubAclId}}",
      "messageType": "EVENT"
    }
  }
}

assert {
  res.status: eq 201
  res.body.subscription.id: isDefined
  res.body.subscription.queueId: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Consumer' });
  
  const queueId = bru.getVar('sec11Consumer1QueueId');
  const aclId = bru.getVar('sec11Consumer1AlertSubAclId');
  if (!queueId || !aclId) {
    throw new Error(
      '11-alerts/32: Missing sec11Consumer1QueueId or sec11Consumer1AlertSubAclId. ' +
      'Steps 28 and 25 must run first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '11-alerts/32 FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  
  const data = res.getBody().subscription;
  bru.setVar('sec11Consumer1AlertSubId', data.id);
  console.log('✓ Consumer 1 alert subscription created: ' + data.id);
}

tests {
  test("Consumer 1 alert subscription created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().subscription.id).to.exist;
  });
  
  test("Subscription references Consumer 1 queue", function() {
    expect(res.getBody().subscription.queueId).to.equal(bru.getVar('sec11Consumer1QueueId'));
  });
}

docs {
  ## Summary
  Creates a subscription binding Consumer 1's queue to alert events.
  
  ## Rationale
  Consumer 1 subscribes to alert events. This proves that the directed alert exclusion
  in steps 44-45 is NOT due to missing subscriptions — Consumer 1 has full alert
  subscription rights but still should not receive its own directed alert back.
  
  ## Expected Result
  - HTTP 201 → `sec11Consumer1AlertSubId` stored
}
