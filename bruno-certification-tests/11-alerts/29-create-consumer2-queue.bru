meta {
  name: 29 Create Consumer 2 Queue
  type: http
  seq: 26
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "cert-alerts-consumer2-q",
      "ownerId": "{{sec11Consumer2EnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

assert {
  res.status: eq 201
  res.body.queue.id: isDefined
  res.body.queue.ownerId: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Consumer2' });
  
  const consumer2EnvId = bru.getVar('sec11Consumer2EnvId');
  if (!consumer2EnvId) {
    throw new Error(
      '11-alerts/29: Missing sec11Consumer2EnvId. Step 20 must run first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '11-alerts/29 FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  
  const data = res.getBody();
  bru.setVar('sec11Consumer2QueueId', data.queue.id);
  console.log('✓ Consumer 2 queue created: ' + data.queue.id);
}

tests {
  test("Consumer 2 queue created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().queue.id).to.exist;
  });
  
  test("Queue owned by Consumer 2", function() {
    expect(res.getBody().queue.ownerId).to.equal(bru.getVar('sec11Consumer2EnvId'));
  });
}

docs {
  ## Summary
  Creates a message queue owned by Consumer 2.
  
  ## Rationale
  Consumer 2 needs a queue to receive TestObjects events from the Provider. This queue
  will also be subscribed to alerts to prove that Consumer 2 does NOT receive a directed
  alert that targets only the Provider.
  
  ## Expected Result
  - HTTP 201 Created
  - `sec11Consumer2QueueId` stored
}
