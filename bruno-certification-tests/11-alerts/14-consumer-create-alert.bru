meta {
  name: 14 Consumer Create Alert
  type: http
  seq: 15
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/alerts/alert
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "alert": {
      "reporter": "ConsumerReporter",
      "exchange": "EVENT",
      "level": "ERROR",
      "description": "Alert created by consumer environment"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Consumer' });

  const consumerToken = bru.getVar('sec11ConsumerSessionToken');
  if (!consumerToken) {
    throw new Error(
      '11-alerts/14-consumer-create-alert: Missing sec11ConsumerSessionToken. ' +
      'Step 06-create-consumer-env must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '11-alerts/14-consumer-create-alert FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec11ConsumerAlertId', data.alert.id);
  console.log('✓ Consumer alert created: ' + bru.getVar('sec11ConsumerAlertId'));
}

assert {
  res.status: eq 201
  res.body.alert: isDefined
  res.body.alert.id: isDefined
}

tests {
  test("Consumer can create alert", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response wrapped under 'alert' key", function() {
    const data = res.getBody();
    expect(data).to.have.property('alert');
  });

  test("Consumer alert has ID", function() {
    const data = res.getBody();
    expect(data.alert.id).to.exist;
  });
}

docs {
  ## Summary
  Creates an alert using consumer credentials.

  ## Rationale
  Sets up a consumer-owned alert so that the next test can verify ownership filtering
  (consumer should only see its own alert, not admin's alert).

  ## Expected Result
  - HTTP 201 Created
  - `sec11ConsumerAlertId` stored for ownership filter verification
}

