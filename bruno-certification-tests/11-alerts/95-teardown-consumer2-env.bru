meta {
  name: 95 Teardown Consumer 2 Environment
  type: http
  seq: 95
}

delete {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/environments/{{sec11Consumer2EnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  X-Run-As-Environment: broker-services
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Admin' });
}

script:post-response {
  // Surgical teardown: delete the second consumer environment this section created
  // in step 20. Deleting the environment cascades its ACL entries, provider
  // registrations, and queues. Tolerant by design — teardown must never fail the run.
  const status = res.getStatus();
  const envId = bru.getVar('sec11Consumer2EnvId');
  if (!envId) {
    console.log('• No sec11Consumer2EnvId to delete — skipping');
  } else if (status === 200 || status === 204) {
    console.log('✓ Consumer 2 environment deleted: ' + envId);
  } else if (status === 404) {
    console.log('✓ Consumer 2 environment already gone (404): ' + envId);
  } else {
    console.error('⚠ Unexpected status ' + status + ' deleting consumer 2 env ' + envId + ' — continuing');
  }
  bru.setVar('sec11Consumer2EnvId', null);
  bru.setVar('sec11Consumer2SessionToken', null);
  bru.setVar('sec11Consumer2SharedSecret', null);
}

docs {
  ## Summary

  Deletes the second consumer environment created in step 20. Runs in both global-admin
  and solution-admin modes (untagged). Deleting the environment cascades its ACL entries,
  provider registrations, and queues.

  ## Expected Result

  - HTTP 200/204: environment deleted
  - HTTP 404: already removed
  - Missing variable: skipped (no-op)
}
