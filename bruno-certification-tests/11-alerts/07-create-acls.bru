meta {
  name: 07 Create Provider PROVIDE ACL
  type: http
  seq: 7
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec11ProviderEnvId}}",
    "serviceName": "alerts",
    "zoneId": "{{sec11ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "PROVIDE",
    "accessLevel": "APPROVED"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Admin' });

  const providerEnvId = bru.getVar('sec11ProviderEnvId');
  const consumerEnvId = bru.getVar('sec11ConsumerEnvId');
  if (!providerEnvId || !consumerEnvId) {
    throw new Error(
      '11-alerts/07-create-acls: Missing prerequisites. ' +
      'sec11ProviderEnvId=' + providerEnvId + ', sec11ConsumerEnvId=' + consumerEnvId
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '11-alerts/07 FAILED: PROVIDE ACL creation returned ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  bru.setVar('sec11ProviderAclId', res.getBody().id);
  console.log('✓ Provider PROVIDE ACL for alerts created: ' + res.getBody().id);
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.zoneId: isDefined
  res.body.contextId: isDefined
}

tests {
  test("Provider PROVIDE ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary
  Creates PROVIDE ACL for alerts service.

  ## Expected Result
  - HTTP 201 → `sec11ProviderAclId` stored
}
