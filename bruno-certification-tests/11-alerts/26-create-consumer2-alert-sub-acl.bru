meta {
  name: 26 Create Consumer 2 SUBSCRIBE ACL for alerts
  type: http
  seq: 23
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/{{sec11SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec11Consumer2EnvId}}",
    "serviceName": "alerts",
    "zoneId": "{{sec11ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "SUBSCRIBE",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec11Admin' });
  
  const consumer2EnvId = bru.getVar('sec11Consumer2EnvId');
  if (!consumer2EnvId) {
    throw new Error(
      '11-alerts/26: Missing sec11Consumer2EnvId. Step 20 must run first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '11-alerts/26 FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  
  bru.setVar('sec11Consumer2AlertSubAclId', res.getBody().id);
  console.log('✓ Consumer 2 SUBSCRIBE ACL for alerts: ' + res.getBody().id);
}

tests {
  test("Consumer 2 SUBSCRIBE ACL for alerts created", function() {
    expect(res.getStatus()).to.equal(201);
    expect(res.getBody().id).to.exist;
  });
}

docs {
  ## Summary
  Creates a SUBSCRIBE ACL for alerts service on Consumer 2.
  
  ## Rationale
  Consumer 2 has alert subscription access to prove that the directed alert exclusion
  is based on delivery logic (only the source environment gets it), not on missing
  permissions. Consumer 2 has full SUBSCRIBE rights but should still NOT receive the
  directed alert because it was not the originator of the referenced message.
  
  ## Expected Result
  - HTTP 201 → `sec11Consumer2AlertSubAclId` stored
}
