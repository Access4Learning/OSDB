meta {
  name: 02 Create Solution
  type: http
  seq: 2
  tags: [
    globaladminonly
  ]
}

post {
  url: {{gatewayUrl}}/{{sec11DomainId}}/solutions
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "solutionId": "{{sec11SolutionName}}",
    "description": "SIF certification solution for section 11 (alerts)"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');

  const domainId = bru.getVar('sec11DomainId');
  if (!domainId) {
    throw new Error(
      '11-alerts/02-create-solution: Missing sec11DomainId. ' +
      'Step 01-create-domain must run successfully first.'
    );
  }

  const now = new Date();
  const ts = now.getFullYear().toString()
    + String(now.getMonth() + 1).padStart(2, '0')
    + String(now.getDate()).padStart(2, '0')
    + '-'
    + String(now.getHours()).padStart(2, '0')
    + String(now.getMinutes()).padStart(2, '0')
    + String(now.getSeconds()).padStart(2, '0')
    + String(now.getMilliseconds()).padStart(3, '0');
  const solutionName = 'cert-solution-' + ts;
  bru.setVar('sec11SolutionName', solutionName);
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '11-alerts/02-create-solution FAILED: expected 200-201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  const solutionId = data.solutionId || bru.getVar('sec11SolutionName');
  bru.setVar('sec11SolutionId', solutionId);
  console.log('✓ Solution created: ' + solutionId + ' in domain: ' + bru.getVar('sec11DomainId'));
}

assert {
  res.status: in [200, 201]
}

tests {
  test("Solution created successfully", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("Solution ID stored", function() {
    const solutionId = bru.getVar('sec11SolutionId');
    expect(solutionId).to.exist;
  });
}

docs {
  ## Summary
  Creates a solution within the section 11 domain.

  ## Rationale
  Solutions are the container for environments, zones, and services.

  ## Expected Result
  - HTTP 201 Created
  - `sec11SolutionId` variable stored for subsequent steps
}

