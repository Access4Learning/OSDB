meta {
  name: 08 Create Queue
  type: http
  seq: 9
}

post {
  url: {{gatewayUrl}}/{{sec06DomainId}}/{{sec06SolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "cert-sec06-queue-{{sec06QueueTs}}",
      "ownerId": "{{sec06ConsumerEnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec06Consumer' });

  const consumerEnvId = bru.getVar('sec06ConsumerEnvId');
  if (!consumerEnvId) {
    throw new Error('sec06ConsumerEnvId not set. Run 03-create-consumer-env first.');
  }

  bru.setVar('sec06QueueTs', Date.now().toString());
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '06-queue-operations/05-create-queue FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec06QueueId', data.queue.id);
  console.log('Queue created for Consumer: ' + data.queue.id + ' (' + data.queue.name + ')');
}

tests {
  test("Queue created successfully", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Queue owned by Consumer", function() {
    const data = res.getBody();
    expect(data.queue.ownerId).to.equal(bru.getVar('sec06ConsumerEnvId'));
  });
}

docs {
  ## Summary

  Creates a queue owned by the consumer environment for receiving event messages.

  ## Rationale

  The consumer's queue will receive events published by the provider once the subscription
  is established. Multiple events will be published to this queue so that the Get Next and
  Pop pattern can be tested with multiple messages in FIFO order.

  ## Expected Result

  - HTTP 201 Created
  - `sec06QueueId` stored for subscription creation and queue message polling
}
