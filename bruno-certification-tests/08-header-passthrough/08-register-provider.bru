meta {
  name: 08 Register Provider
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{sec08DomainId}}/{{sec08SolutionId}}/providers/provider
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "provider": {
      "environmentId": "{{sec08ProviderEnvId}}",
      "serviceName": "{{sec08ServiceName}}",
      "zoneId": "{{sec08ZoneId}}",
      "contextId": "{{sec08ContextId}}",
      "providerName": "{{sec08ProviderName}}",
      "querySupport": {},
      "serviceType": "OBJECT",
      "endPoint": {
        "location": "{{immediateProviderEndpointUrl}}/{{immediateProviderServiceName}}"
      },
      "supportedRequestTypes": {
        "supportedRequestType": [
          {
            "requestType": "IMMEDIATE",
            "operations": {
              "operation": [
                "CREATE",
                "QUERY",
                "UPDATE",
                "DELETE"
              ]
            }
          }
        ]
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.provider.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec08Admin' });

  const providerEnvId = bru.getVar('sec08ProviderEnvId');
  const sec08ServiceName = bru.getVar('sec08ServiceName');
  const sec08ZoneId = bru.getVar('sec08ZoneId');
  const sec08ContextId = bru.getVar('sec08ContextId');
  if (!providerEnvId || !sec08ServiceName || !sec08ZoneId || !sec08ContextId) {
    throw new Error(
      '08-header-passthrough/08-register-provider: Missing sec08ProviderEnvId, sec08ServiceName, sec08ZoneId, or sec08ContextId. ' +
      'Run previous setup steps first.'
    );
  }

  const endpointUrl = bru.getEnvVar('immediateProviderEndpointUrl');
  const serviceName = bru.getEnvVar('immediateProviderServiceName');
  if (!endpointUrl || !serviceName) {
    throw new Error(
      '08-header-passthrough/08-register-provider: Missing environment variables. ' +
      'Set immediateProviderEndpointUrl and immediateProviderServiceName.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '08-header-passthrough/08-register-provider FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().provider;
  bru.setVar('sec08ProviderRegistrationId', data.id);
  console.log('✓ Registered provider:', data.id);
  console.log('  Service:', data.serviceName);
  console.log('  Endpoint:', data.endPoint.location);
}

docs {
  ## Summary
  Registers the external provider for IMMEDIATE request handling.

  ## Expected Result
  - HTTP 201 Created
  - `sec08ProviderRegistrationId` stored
}
