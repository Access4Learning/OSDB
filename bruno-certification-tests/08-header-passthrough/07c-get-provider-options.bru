meta {
  name: 07c Get Provider Options
  type: http
  seq: 9
}

get {
  url: {{gatewayUrl}}/{{sec08DomainId}}/{{sec08SolutionId}}/provider-registrations/available-options?environmentId={{sec08ProviderEnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec08Admin' });

  const providerEnvId = bru.getVar('sec08ProviderEnvId');
  if (!providerEnvId) {
    throw new Error('07c-get-provider-options: Missing sec08ProviderEnvId.');
  }
}

script:post-response {
  const status = res.getStatus();
  const data = res.getBody();

  if (status !== 200 || !data || data.length === 0) {
    throw new Error(
      '08-header-passthrough/07c-get-provider-options: No available provider options found. ' +
      'Ensure PROVIDE ACL was created. Status: ' + status
    );
  }

  const serviceName = bru.getEnvVar('immediateProviderServiceName');
  const option = data.find(o => o.serviceName === serviceName);
  if (!option) {
    throw new Error(
      '08-header-passthrough/07c: No available option for service "' + serviceName + '". ' +
      'Available: ' + data.map(o => o.serviceName).join(', ')
    );
  }

  bru.setVar('sec08ContextServiceUuid', option.contextServiceUuid);
  console.log('✓ Found contextServiceUuid for ' + serviceName + ': ' + option.contextServiceUuid);
}

tests {
  test("Provider options returned", function() {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.be.an('array').and.not.be.empty;
  });

  test("contextServiceUuid stored", function() {
    const uuid = bru.getVar('sec08ContextServiceUuid');
    expect(uuid).to.be.a('string').and.not.be.empty;
  });
}

docs {
  ## Summary
  Fetches available provider options to obtain contextServiceUuid for registration.

  ## Expected Result
  - HTTP 200 with options array
  - `sec08ContextServiceUuid` stored
}
