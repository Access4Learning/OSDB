meta {
  name: 07 Create ACLs
  type: http
  seq: 7
}

post {
  url: {{gatewayUrl}}/{{sec08DomainId}}/{{sec08SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec08ProviderEnvId}}",
    "serviceName": "{{immediateProviderServiceName}}",
    "zoneId": "{{sec08ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "PROVIDE",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.zoneId: isDefined
  res.body.contextId: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec08Admin' });

  const zoneId = bru.getVar('sec08ZoneId');
  if (!zoneId) {
    throw new Error(
      '08-header-passthrough/04-create-acls: Missing sec08ZoneId. ' +
      'Run 01-setup-zone first.'
    );
  }

  const serviceName = bru.getEnvVar('immediateProviderServiceName');
  if (!serviceName) {
    throw new Error(
      '08-header-passthrough/04-create-acls: Missing environment variable "immediateProviderServiceName".'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '08-header-passthrough/04-create-acls: Failed to create PROVIDE ACL, got ' + status +
      '. Response: ' + JSON.stringify(res.getBody())
    );
  }

  const provideData = res.getBody();
  bru.setVar('sec08ProvideAclId', provideData.id);
  console.log('✓ Created PROVIDE ACL:', provideData.id);
}

tests {
  test("Provider PROVIDE ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary
  Creates PROVIDE ACL entry for header passthrough tests.

  ## Expected Result
  - PROVIDE ACL created → `sec08ProvideAclId`
}
