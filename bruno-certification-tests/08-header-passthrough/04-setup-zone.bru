meta {
  name: 04 Setup Zone
  type: http
  seq: 4
}

post {
  url: {{gatewayUrl}}/{{sec08DomainId}}/{{sec08SolutionId}}/zones/zone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  X-Run-As-Environment: broker-services
}

body:json {
  {
    "zone": {
      "id": "cert-hdrpass-{{$timestamp}}",
      "description": "Zone for header passthrough certification tests"
    }
  }
}

assert {
  res.status: eq 201
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec08Admin' });

  const domainId = bru.getVar('sec08DomainId');
  const solutionId = bru.getVar('sec08SolutionId');
  if (!domainId || !solutionId) {
    throw new Error(
      '08-header-passthrough/01-setup-zone: Missing sec08DomainId or sec08SolutionId. ' +
      'Run steps 01-03 first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '08-header-passthrough/01-setup-zone FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec08ZoneId', data.zone.id);
  console.log('Ã¢Å“â€œ Created zone:', bru.getVar('sec08ZoneId'));
}

docs {
  ## Summary

  Creates a dedicated zone for header passthrough tests.

  ## Rationale

  Each test section creates its own zone for isolation. This ensures
  no interference from other test sections and enables clean teardown.

  ## Expected Result

  - HTTP 201 Created
  - Zone ID stored in `sec08ZoneId` Bruno variable
}

