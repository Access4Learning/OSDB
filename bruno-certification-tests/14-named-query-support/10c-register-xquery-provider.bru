meta {
  name: 10c Register xQuery Provider
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{sec14DomainId}}/{{sec14SolutionId}}/providers/provider
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "provider": {
      "environmentId": "{{sec14ProviderEnvId}}",
      "serviceName": "{{sec14ServiceName}}",
      "zoneId": "{{sec14ZoneId}}",
      "contextId": "{{sec14ContextId}}",
      "querySupport": {},
      "serviceType": "XQUERYTEMPLATE",
      "endPoint": {
        "location": "{{immediateProviderEndpointUrl}}/StudentSnapshot"
      },
      "supportedRequestTypes": {
        "supportedRequestType": [
          {
            "requestType": "IMMEDIATE",
            "operations": {
              "operation": [
                "QUERY"
              ]
            }
          }
        ]
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.provider.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec14Admin' });

  const providerEnvId = bru.getVar('sec14ProviderEnvId');
  const sec14ServiceName = bru.getVar('sec14ServiceName');
  const sec14ZoneId = bru.getVar('sec14ZoneId');
  const sec14ContextId = bru.getVar('sec14ContextId');
  if (!providerEnvId || !sec14ServiceName || !sec14ZoneId || !sec14ContextId) {
    throw new Error(
      '14-named-query-support/10c-register-xquery-provider: Missing sec14ProviderEnvId, sec14ServiceName, sec14ZoneId, or sec14ContextId. ' +
      'Steps 05 and 10b must run successfully first.'
    );
  }

  const endpointUrl = bru.getEnvVar('immediateProviderEndpointUrl');
  if (!endpointUrl) {
    throw new Error(
      '14-named-query-support/10c-register-xquery-provider: Missing environment variable "immediateProviderEndpointUrl". ' +
      'Set it in your environment file.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '14-named-query-support/10c-register-xquery-provider FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().provider;
  bru.setVar('sec14ProviderRegistrationId', data.id);
  console.log('✓ Provider registered for StudentSnapshot xQuery: ' + data.id);
  console.log('  Endpoint: ' + data.endPoint.location);
  console.log('  ServiceType: XQUERYTEMPLATE');
}

tests {
  test("Provider registration for XQUERYTEMPLATE created", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody().provider;
    expect(data.id).to.exist;
  });
}

docs {
  ## Summary
  Registers the provider to serve the "StudentSnapshot" Named Query via
  POST /providers/provider with serviceType=XQUERYTEMPLATE.

  ## Rationale
  Per the decoupled architecture (xquery-provider-registration-fix), template catalog
  management and provider registration are separate operations. After the admin creates
  the template in step 10, the provider separately registers to serve it here.

  The provider specifies:
  - serviceName, zoneId, contextId: obtained from available-options in step 10b
  - endpoint: the URL where the provider handles query requests
  - serviceType: XQUERYTEMPLATE
  - supportedRequestTypes: IMMEDIATE with QUERY operation

  This enables the requests-connector to route consumer queries (step 13) to this
  provider's endpoint.

  ## Expected Result
  - HTTP 201 Created
  - `sec14ProviderRegistrationId` stored for cleanup
}
