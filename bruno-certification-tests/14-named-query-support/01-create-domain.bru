meta {
  name: 01 Create Domain
  type: http
  seq: 1
}

post {
  url: {{gatewayUrl}}/domains
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "domainId": "{{sec14DomainName}}",
    "description": "SIF certification domain for section 14 (named-query-support)"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');

  const now = new Date();
  const ts = now.getFullYear().toString()
    + String(now.getMonth() + 1).padStart(2, '0')
    + String(now.getDate()).padStart(2, '0')
    + '-'
    + String(now.getHours()).padStart(2, '0')
    + String(now.getMinutes()).padStart(2, '0')
    + String(now.getSeconds()).padStart(2, '0')
    + String(now.getMilliseconds()).padStart(3, '0');
  const domainName = 'cert-sec14-' + ts;
  bru.setVar('sec14DomainName', domainName);
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '14-named-query-support/01-create-domain FAILED: expected 200-201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  const domainId = data.domainId || bru.getVar('sec14DomainName');
  bru.setVar('sec14DomainId', domainId);
  console.log('✓ Domain created: ' + domainId);
}

assert {
  res.status: in [200, 201]
}

tests {
  test("Domain created successfully", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("Domain ID stored", function() {
    expect(bru.getVar('sec14DomainId')).to.exist;
  });
}

docs {
  ## Summary
  Creates a uniquely-named domain for the named query support test section.

  ## Expected Result
  - HTTP 201 Created
  - `sec14DomainId` variable stored for subsequent steps
}

