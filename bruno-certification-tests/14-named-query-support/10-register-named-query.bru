meta {
  name: 10 Register Named Query
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{sec14DomainId}}/{{sec14SolutionId}}/xquerys/xquery
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "xquery": {
      "id": "StudentSnapshot",
      "type": "SINGULAR",
      "status": "APPROVED",
      "description": "Returns a snapshot of student data filtered by parameters",
      "script": "SELECT * FROM students WHERE grade = :grade",
      "parameters": {
        "parameter": [
          {
            "name": "grade",
            "type": "xs:string",
            "description": "Grade level to filter by",
            "required": true
          },
          {
            "name": "schoolYear",
            "type": "xs:string",
            "default": "2024",
            "description": "School year for the snapshot",
            "required": false
          }
        ]
      },
      "returnType": "http://www.sifassociation.org/datamodel/na/4.x/StudentPersonal"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec14Admin' });

  const providerEnvId = bru.getVar('sec14ProviderEnvId');
  if (!providerEnvId) {
    throw new Error(
      '14-named-query-support/10-register-named-query: Missing sec14ProviderEnvId. ' +
      'Step 05-create-provider-env must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '14-named-query-support/10-register-named-query FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec14QueryToken', data.xquery.id);
  console.log('✓ Named Query Template registered: token=' + data.xquery.id);
}

assert {
  res.status: eq 201
  res.body.xquery.id: eq StudentSnapshot
  res.body.xquery.type: eq SINGULAR
  res.body.xquery.status: eq APPROVED
}

tests {
  test("Named Query Template registered successfully", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.xquery).to.exist;
    expect(data.xquery.id).to.equal("StudentSnapshot");
    expect(data.xquery.type).to.equal("SINGULAR");
    expect(data.xquery.status).to.equal("APPROVED");
    expect(data.xquery.description).to.exist;
    expect(data.xquery.parameters.parameter).to.be.an("array").with.lengthOf(2);
    expect(data.xquery.returnType).to.exist;
  });
}

docs {
  ## Summary
  Registers a Named Query Template with queryToken "StudentSnapshot" using admin credentials.

  ## Rationale
  Per the decoupled architecture (xquery-provider-registration-fix), template catalog
  management is an admin operation. The admin creates the catalog entry, and providers
  separately register to serve it via POST /providers/provider.

  The queryToken "StudentSnapshot" matches the consumer's QUERY ACL created in step 08,
  enabling the consumer to invoke this query in step 13.

  ## Expected Result
  - HTTP 201 Created
  - Response body contains `xquery` envelope with template fields
  - `sec14QueryToken` stored for subsequent steps
}
