meta {
  name: 05 Create Provider Environment
  type: http
  seq: 5
}

post {
  url: {{gatewayUrl}}/{{sec14DomainId}}/{{sec14SolutionId}}/environments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "applicationName": "CertProvider-NamedQuery-{{$timestamp}}",
    "type": "BROKERED",
    "defaultZoneId": "{{sec14ZoneId}}"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.sessionToken: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec14Admin' });
  
  const zoneId = bru.getVar('sec14ZoneId');
  if (!zoneId) {
    throw new Error(
      '14-named-query-support/05-create-provider-env: Missing sec14ZoneId. ' +
      'Step 04-setup-zone must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '14-named-query-support/05-create-provider-env FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  
  const data = res.getBody();
  bru.setVar('sec14ProviderEnvId', data.id);
  bru.setVar('sec14ProviderSessionToken', data.sessionToken);
  bru.setVar('sec14ProviderSharedSecret', data.sharedSecret);
  console.log('✓ Provider environment created: ' + data.id);
}

tests {
  test("Provider environment created with type DIRECT", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
  });
}

docs {
  ## Summary
  Registers a provider environment with type DIRECT for named query support tests.
  
  ## Rationale
  The provider registers Named Query Templates and serves query responses directly.
  DIRECT type means the broker forwards invocations to the provider's endpoint.
  
  ## Expected Result
  - HTTP 201 Created
  - `sec14ProviderEnvId`, `sec14ProviderSessionToken`, `sec14ProviderSharedSecret` stored
}
