meta {
  name: 13 Consumer Invoke Named Query
  type: http
  seq: 13
}

get {
  url: {{gatewayUrl}}/{{sec14DomainId}}/{{sec14SolutionId}}/requests/{{sec14QueryToken}}?grade=10&schoolYear=2024
  body: none
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  serviceType: XQUERYTEMPLATE
  zoneId: {{sec14ZoneId}}
  contextId: DEFAULT
}

assert {
  res.status: neq 403
  res.status: neq 500
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec14Consumer' });
  
  const queryToken = bru.getVar('sec14QueryToken');
  if (!queryToken) {
    throw new Error(
      '14-named-query-support/13-consumer-invoke-query: Missing sec14QueryToken. ' +
      'Step 10-register-named-query must run successfully first.'
    );
  }
  
  console.log('Consumer invoke — serviceType=XQUERYTEMPLATE, token=' + queryToken);
  console.log('  sec14ZoneId (used for ACL): ' + bru.getVar('sec14ZoneId'));
  console.log('  sec14ConsumerEnvId: ' + bru.getVar('sec14ConsumerEnvId'));
}

script:post-response {
  const status = res.getStatus();
  // The consumer holds a valid QUERY ACL, so the gateway must NOT reject with 403.
  // Routing must reach the requests-connector without an unhandled server error (500).
  // Whether the call ultimately returns 2xx depends on a live provider backend at
  // immediateProviderEndpointUrl; without one the connector returns 404 (NO_PROVIDER),
  // 502 (PROVIDER_UNAVAILABLE), or 504 (PROVIDER_TIMEOUT) — all acceptable here.
  if (status === 403) {
    throw new Error(
      '14-named-query-support/13-consumer-invoke-query FAILED: got 403 — ' +
      'gateway ACL enforcement incorrectly rejected a consumer with a valid QUERY ACL. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  if (status === 500) {
    throw new Error(
      '14-named-query-support/13-consumer-invoke-query FAILED: got 500 — ' +
      'unhandled server error during named query routing. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }
  console.log('✓ Consumer invoke routed past ACL (status=' + status + ')');
}

tests {
  test("Gateway ACL enforcement passed (not 403)", function() {
    expect(res.getStatus()).to.not.equal(403);
  });

  test("Routing reached connector without unhandled server error (not 500)", function() {
    expect(res.getStatus()).to.not.equal(500);
  });

  test("Status is a routed outcome (2xx, 404, 502, or 504)", function() {
    const status = res.getStatus();
    const acceptable = [200, 201, 202, 204, 404, 502, 504];
    expect(acceptable).to.include(status);
  });
}

docs {
  ## Summary
  Consumer invokes the Named Query "StudentSnapshot" via GET /requests/{queryToken}
  with `serviceType: XQUERYTEMPLATE` header and query parameters.
  
  ## Rationale
  Per requirements 3.1 and 5.1:
  - Consumer sends GET /requests/StudentSnapshot?grade=10&schoolYear=2024
  - Consumer includes header `serviceType: XQUERYTEMPLATE`
  - Gateway extracts "StudentSnapshot" as serviceName, checks QUERY ACL
  - Requests-connector looks up provider by serviceName + serviceType=XQUERYTEMPLATE
  - Request is forwarded to provider
  
  In certification tests without a real provider backend, we validate that:
  1. The gateway ACL check passes (not 403)
  2. The routing logic reaches the requests-connector
  
  ## Expected Result
  - NOT 403 (proves gateway ACL enforcement passed for consumer with QUERY ACL)
  - Actual status depends on provider availability (likely 404 or 502 in test env)
}
