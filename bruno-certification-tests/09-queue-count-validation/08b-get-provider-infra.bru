meta {
  name: 08b Get Provider Infrastructure
  type: http
  seq: 10
}

get {
  url: {{gatewayUrl}}/{{sec09DomainId}}/{{sec09SolutionId}}/environments/{{sec09ProviderEnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec09Admin' });

  const providerEnvId = bru.getVar('sec09ProviderEnvId');
  if (!providerEnvId) {
    throw new Error('08b-get-provider-infra: Missing sec09ProviderEnvId.');
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 200) {
    throw new Error('Failed to fetch provider environment: status ' + status);
  }

  const envData = res.getBody();
  if (envData.infrastructureServices && envData.infrastructureServices.infrastructureService) {
    const services = envData.infrastructureServices.infrastructureService;
    const eventsConnector = services.find(s => s.name === 'eventsConnector');
    if (eventsConnector) {
      bru.setVar('sec09ProviderEventsUrl', eventsConnector.value);
      console.log('✓ Provider EVENTS_CONNECTOR URL: ' + eventsConnector.value);
    } else {
      throw new Error('EVENTS_CONNECTOR not found in provider infrastructure services');
    }
  } else {
    throw new Error('No infrastructure services found on provider environment');
  }
}

tests {
  test("Provider environment fetched", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Provider events URL stored", function() {
    const eventsUrl = bru.getVar('sec09ProviderEventsUrl');
    expect(eventsUrl).to.be.a('string').and.not.be.empty;
  });
}

docs {
  ## Summary
  Fetches the provider environment to extract EVENTS_CONNECTOR URL.

  ## Expected Result
  - HTTP 200
  - `sec09ProviderEventsUrl` stored
}
