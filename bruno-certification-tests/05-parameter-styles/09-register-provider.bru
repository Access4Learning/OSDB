meta {
  name: 09 Register Provider
  type: http
  seq: 12
}

post {
  url: {{gatewayUrl}}/{{sec05DomainId}}/{{sec05SolutionId}}/providers/provider
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "provider": {
      "environmentId": "{{sec05ProviderEnvId}}",
      "serviceName": "{{sec05ServiceName}}",
      "zoneId": "{{sec05ZoneId}}",
      "contextId": "{{sec05ContextId}}",
      "querySupport": {},
      "serviceType": "OBJECT",
      "endPoint": {
        "location": "{{immediateProviderEndpointUrl}}/{{immediateProviderServiceName}}"
      },
      "supportedRequestTypes": {
        "supportedRequestType": [
          {
            "requestType": "IMMEDIATE",
            "operations": {
              "operation": [
                "CREATE",
                "QUERY",
                "UPDATE",
                "DELETE"
              ]
            }
          }
        ]
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.provider.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec05Admin' });

  const providerEnvId = bru.getVar('sec05ProviderEnvId');
  const sec05ServiceName = bru.getVar('sec05ServiceName');
  const sec05ZoneId = bru.getVar('sec05ZoneId');
  const sec05ContextId = bru.getVar('sec05ContextId');
  if (!providerEnvId || !sec05ServiceName || !sec05ZoneId || !sec05ContextId) {
    throw new Error(
      '05-parameter-styles/09-register-provider: Missing sec05ProviderEnvId, sec05ServiceName, sec05ZoneId, or sec05ContextId. ' +
      'Run previous setup steps first.'
    );
  }

  const endpointUrl = bru.getEnvVar('immediateProviderEndpointUrl');
  const serviceName = bru.getEnvVar('immediateProviderServiceName');
  if (!endpointUrl || !serviceName) {
    throw new Error(
      '05-parameter-styles/09-register-provider: Missing environment variables. ' +
      'Set immediateProviderEndpointUrl and immediateProviderServiceName.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '05-parameter-styles/09-register-provider FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().provider;
  bru.setVar('sec05ProviderRegistrationId', data.id);
  console.log('✓ Registered provider:', data.id);
}

docs {
  ## Summary
  Registers the external provider for IMMEDIATE request handling in the parameter-styles tests.

  ## Expected Result
  - HTTP 201 Created
  - Provider registration ID stored in `sec05ProviderRegistrationId`
}
