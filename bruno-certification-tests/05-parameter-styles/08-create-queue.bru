meta {
  name: 08 Create Consumer Queue
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{sec05DomainId}}/{{sec05SolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "cert-params-queue",
      "ownerId": "{{sec05ConsumerEnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

assert {
  res.status: eq 201
  res.body.queue.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec05Consumer' });

  const consumerEnvId = bru.getVar('sec05ConsumerEnvId');
  if (!consumerEnvId) {
    throw new Error(
      '05-parameter-styles/05-create-queue: Missing sec05ConsumerEnvId. ' +
      'Run 03-create-consumer-env first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '05-parameter-styles/05-create-queue FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec05QueueId', data.queue.id);
  console.log('Created consumer queue:', data.queue.id);
}

docs {
  ## Summary

  Creates a queue owned by the consumer environment for receiving events and delayed responses.

  ## Rationale

  The consumer queue receives events published with both header-based and matrix
  parameter styles. It also supports subscription creation tests in this section.

  ## Expected Result

  - HTTP 201 Created
  - Queue ID stored in `sec05QueueId` Bruno variable
}
