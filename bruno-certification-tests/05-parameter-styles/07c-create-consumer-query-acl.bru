meta {
  name: 07c Create Consumer QUERY ACL
  type: http
  seq: 9
}

post {
  url: {{gatewayUrl}}/{{sec05DomainId}}/{{sec05SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec05ConsumerEnvId}}",
    "serviceName": "{{immediateProviderServiceName}}",
    "zoneId": "{{sec05ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "QUERY",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec05Admin' });

  const consumerEnvId = bru.getVar('sec05ConsumerEnvId');
  if (!consumerEnvId) {
    throw new Error('07c-create-consumer-query-acl: Missing sec05ConsumerEnvId.');
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '05-parameter-styles/07c: Failed to create QUERY ACL, got ' +
      status + ': ' + JSON.stringify(res.getBody())
    );
  }
  bru.setVar('sec05QueryAclId', res.getBody().id);
  console.log('✓ Created QUERY ACL:', res.getBody().id);
}

tests {
  test("Consumer QUERY ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary

  Creates QUERY ACL for the consumer environment.

  ## Expected Result

  - HTTP 201 Created → `sec05QueryAclId` stored
}
