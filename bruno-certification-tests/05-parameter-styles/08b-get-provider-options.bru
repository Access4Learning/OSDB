meta {
  name: 08b Get Provider Options
  type: http
  seq: 11
}

get {
  url: {{gatewayUrl}}/{{sec05DomainId}}/{{sec05SolutionId}}/providers/available-options?environmentId={{sec05ProviderEnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec05Admin' });

  const providerEnvId = bru.getVar('sec05ProviderEnvId');
  if (!providerEnvId) {
    throw new Error('05-parameter-styles/08b-get-provider-options: Missing sec05ProviderEnvId.');
  }
}

script:post-response {
  const status = res.getStatus();
  const data = res.getBody();

  if (status !== 200 || !data || data.length === 0) {
    throw new Error(
      '05-parameter-styles/08b-get-provider-options: No available provider options found. ' +
      'Ensure PROVIDE ACL was created. Status: ' + status + ', Data: ' + JSON.stringify(data)
    );
  }

  const serviceName = bru.getEnvVar('immediateProviderServiceName');
  const option = data.find(o => o.serviceName === serviceName);
  if (!option) {
    throw new Error(
      '05-parameter-styles/08b-get-provider-options: No available option for service "' + serviceName + '". ' +
      'Available: ' + data.map(o => o.serviceName).join(', ')
    );
  }

  bru.setVar('sec05ContextServiceUuid', option.contextServiceUuid);
  bru.setVar('sec05ServiceName', option.serviceName);
  bru.setVar('sec05ZoneId', option.zoneId);
  bru.setVar('sec05ContextId', option.contextId);
  console.log('✓ Found contextServiceUuid for ' + serviceName + ': ' + option.contextServiceUuid);
}

tests {
  test("Provider options returned", function() {
    expect(res.getStatus()).to.equal(200);
    const data = res.getBody();
    expect(data).to.be.an('array').and.not.be.empty;
  });

  test("contextServiceUuid stored", function() {
    const uuid = bru.getVar('sec05ContextServiceUuid');
    expect(uuid).to.be.a('string').and.not.be.empty;
  });
}

docs {
  ## Summary
  Fetches available provider registration options to obtain the contextServiceUuid.

  ## Expected Result
  - HTTP 200 with array of available options
  - `sec05ContextServiceUuid` stored for provider registration
}
