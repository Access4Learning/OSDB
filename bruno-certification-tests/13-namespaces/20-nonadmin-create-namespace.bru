meta {
  name: 20 Non-Admin Create Namespace
  type: http
  seq: 20
}

post {
  url: {{gatewayUrl}}/{{sec13DomainId}}/{{sec13SolutionId}}/namespaces/namespace
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "namespace": {
      "zone": "environment-global",
      "uri": "http://www.unauthorized.org/test/{{$timestamp}}",
      "url": "http://www.unauthorized.org/test/schema.xsd"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec13Consumer' });

  const consumerToken = bru.getVar('sec13ConsumerSessionToken');
  if (!consumerToken) {
    throw new Error(
      '13-namespaces/20-nonadmin-create-namespace: Missing sec13ConsumerSessionToken. ' +
      'Step 04-create-consumer-env must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status === 201) {
    throw new Error(
      '13-namespaces/20-nonadmin-create-namespace FAILED: expected 403, got 201. ' +
      'Non-admin should not be able to create namespaces.'
    );
  }
  console.log('✓ Non-admin create correctly rejected with status: ' + status);
}

assert {
  res.status: eq 403
}

tests {
  test("Non-admin create rejected with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  ## Summary
  Attempts to create a namespace as a non-admin consumer.

  ## Rationale
  Namespace management is admin-only. Non-admin environments should receive 403 Forbidden.

  ## Expected Result
  - HTTP 403 Forbidden
}

