meta {
  name: 04 Create Consumer Environment
  type: http
  seq: 4
}

post {
  url: {{gatewayUrl}}/{{sec13DomainId}}/{{sec13SolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "applicationName": "CertConsumer-Namespaces-{{$timestamp}}",
    "type": "BROKERED"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec13Admin' });

  const solutionId = bru.getVar('sec13SolutionId');
  if (!solutionId) {
    throw new Error(
      '13-namespaces/04-create-consumer-env: Missing sec13SolutionId. ' +
      'Previous steps must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '13-namespaces/04-create-consumer-env FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec13ConsumerEnvId', data.id);
  bru.setVar('sec13ConsumerSessionToken', data.sessionToken);
  bru.setVar('sec13ConsumerSharedSecret', data.sharedSecret);
  console.log('✓ Consumer environment created: ' + data.id);
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.sessionToken: isDefined
}

tests {
  test("Consumer environment created", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
  });
}

docs {
  ## Summary
  Creates a BROKERED consumer environment for non-admin access testing.

  ## Rationale
  A non-admin environment is needed to verify that namespace write operations
  (create, update, delete) are restricted to admin only.

  ## Expected Result
  - HTTP 201 Created
  - `sec13ConsumerEnvId`, `sec13ConsumerSessionToken`, `sec13ConsumerSharedSecret` stored
}

