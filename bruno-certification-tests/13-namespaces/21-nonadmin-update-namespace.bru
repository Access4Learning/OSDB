meta {
  name: 21 Non-Admin Update Namespace
  type: http
  seq: 21
}

put {
  url: {{gatewayUrl}}/{{sec13DomainId}}/{{sec13SolutionId}}/namespaces/00000000-0000-0000-0000-000000000000
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "namespace": {
      "zone": "environment-global",
      "uri": "http://www.unauthorized.org/test/updated",
      "url": "http://www.unauthorized.org/test/schema-updated.xsd"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec13Consumer' });
}

script:post-response {
  const status = res.getStatus();
  if (status === 200) {
    throw new Error(
      '13-namespaces/21-nonadmin-update-namespace FAILED: expected 403, got 200. ' +
      'Non-admin should not be able to update namespaces.'
    );
  }
  console.log('✓ Non-admin update correctly rejected with status: ' + status);
}

assert {
  res.status: eq 403
}

tests {
  test("Non-admin update rejected with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  ## Summary
  Attempts to update a namespace as a non-admin consumer.

  ## Rationale
  Namespace management is admin-only. Non-admin environments should receive 403 Forbidden.

  ## Expected Result
  - HTTP 403 Forbidden
}

