meta {
  name: 14 Delete Namespace
  type: http
  seq: 14
}

delete {
  url: {{gatewayUrl}}/{{sec13DomainId}}/{{sec13SolutionId}}/namespaces/{{sec13NamespaceId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec13Admin' });

  const namespaceId = bru.getVar('sec13NamespaceId');
  if (!namespaceId) {
    throw new Error(
      '13-namespaces/14-delete-namespace: Missing sec13NamespaceId. ' +
      'Step 10-create-namespace must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 204) {
    throw new Error(
      '13-namespaces/14-delete-namespace FAILED: expected 204, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  console.log('✓ Namespace deleted: ' + bru.getVar('sec13NamespaceId'));
}

assert {
  res.status: eq 204
}

tests {
  test("Namespace deleted with status 204", function() {
    expect(res.getStatus()).to.equal(204);
  });
}

docs {
  ## Summary
  Deletes a namespace (admin only).

  ## Rationale
  Verifies that DELETE /namespaces/{id} removes the namespace and returns 204.

  ## Expected Result
  - HTTP 204 No Content
}

