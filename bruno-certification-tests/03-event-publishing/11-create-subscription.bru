meta {
  name: 11 Create Subscription
  type: http
  seq: 15
}

post {
  url: {{gatewayUrl}}/{{sec03DomainId}}/{{sec03SolutionId}}/subscriptions/subscription
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "subscription": {
      "queueId": "{{sec03Queue1Id}}",
      "aclEntryId": "{{sec03SubscribeAclId}}",
      "messageType": "EVENT"
    }
  }
}

assert {
  res.status: eq 201
  res.body.subscription.id: isDefined
  res.body.subscription.queueId: isDefined
  res.body.subscription.messageType: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec03Consumer1' });

  const queueId = bru.getVar('sec03Queue1Id');
  const aclId = bru.getVar('sec03SubscribeAclId');
  const eventsUrl = bru.getVar('sec03ProviderEventsUrl');
  if (!queueId || !aclId) {
    throw new Error(
      '03-event-publishing/11: Missing sec03Queue1Id or sec03SubscribeAclId.'
    );
  }
  if (!eventsUrl) {
    throw new Error(
      '03-event-publishing/11: Missing sec03ProviderEventsUrl. Run 10a first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '03-event-publishing/11 FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().subscription;
  bru.setVar('sec03SubscriptionId', data.id);
  console.log('✓ Subscription created: ' + data.id);
  console.log('  Queue: ' + data.queueId);
  console.log('  Message Type: ' + data.messageType);
}

tests {
  test("Subscription created successfully", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response contains subscription wrapper key", function() {
    const body = res.getBody();
    expect(body).to.have.property('subscription');
  });

  test("Subscription references correct queue", function() {
    expect(res.getBody().subscription.queueId).to.equal(bru.getVar('sec03Queue1Id'));
  });

  test("Subscription message type is EVENT", function() {
    expect(res.getBody().subscription.messageType).to.equal('EVENT');
  });

  test("Provider events URL is stored", function() {
    expect(bru.getVar('sec03ProviderEventsUrl')).to.be.a('string').and.not.be.empty;
  });
}

docs {
  ## Summary
  Creates subscription binding Consumer 1's queue to provider events.
  Infrastructure URLs were resolved in steps 10a-10c.

  Per SIF 3.7, uses singular resource URL (/subscriptions/subscription)
  and wraps payload in {"subscription": {...}} envelope.

  ## Expected Result
  - HTTP 201 → response wrapped in {"subscription": {...}}
  - `sec03SubscriptionId` stored from response
}
