meta {
  name: 10c Get Consumer2 Infrastructure
  type: http
  seq: 14
}

get {
  url: {{gatewayUrl}}/{{sec03DomainId}}/{{sec03SolutionId}}/environments/{{sec03Consumer2EnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec03Admin' });
}

script:post-response {
  const envData = res.getBody().environment;
  if (envData.infrastructureServices && envData.infrastructureServices.infrastructureService) {
    const services = envData.infrastructureServices.infrastructureService;
    const queuesService = services.find(s => s.name === 'queues');
    if (queuesService) {
      bru.setVar('sec03Consumer2QueuesUrl', queuesService.value);
      console.log('✓ Consumer 2 QUEUES URL: ' + queuesService.value);
    }
  }
}

tests {
  test("Consumer 2 environment fetched", function() {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  ## Summary
  Fetches Consumer 2 environment to extract QUEUES URL.

  ## Expected Result
  - HTTP 200
  - `sec03Consumer2QueuesUrl` stored
}
