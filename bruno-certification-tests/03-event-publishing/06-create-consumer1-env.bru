meta {
  name: 06 Create Consumer 1 Environment
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/{{sec03DomainId}}/{{sec03SolutionId}}/environments
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "applicationName": "sec03-consumer1-{{$timestamp}}",
    "type": "BROKERED",
    "defaultZoneId": "{{sec03ZoneId}}"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec03Admin' });
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '03-event-publishing/03-create-consumer1-env FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec03Consumer1EnvId', data.id);
  bru.setVar('sec03Consumer1SessionToken', data.sessionToken);
  bru.setVar('sec03Consumer1SharedSecret', data.sharedSecret);
  console.log('âœ“ Consumer 1 environment created: ' + data.id);
  console.log('  Application Name: ' + data.applicationName);
  console.log('  Type: ' + data.type);
}

tests {
  test("Consumer 1 environment created", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response contains credentials", function() {
    const data = res.getBody();
    expect(data).to.have.property('id');
    expect(data).to.have.property('sessionToken');
    expect(data).to.have.property('sharedSecret');
  });

  test("Environment type is BROKERED", function() {
    const data = res.getBody();
    expect(data.type).to.equal('BROKERED');
  });
}

docs {
  ## Summary

  Creates a BROKERED-type consumer environment (Consumer 1) that will receive events.

  ## Rationale

  BROKERED environments receive messages via queues managed by the broker. Consumer 1
  will be the "subscribed" consumer â€” it will have a subscription binding its queue to
  the provider's service events. Its credentials are stored for queue polling.

  ## Expected Result

  - HTTP 201 Created
  - `sec03Consumer1EnvId` set to environment UUID
  - `sec03Consumer1SessionToken` stored for consumer authentication
  - `sec03Consumer1SharedSecret` stored for consumer authentication
}
