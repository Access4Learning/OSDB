meta {
  name: 08a Create Provider ACL
  type: http
  seq: 8
}

post {
  url: {{gatewayUrl}}/{{sec03DomainId}}/{{sec03SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec03ProviderEnvId}}",
    "serviceName": "CertEventObjects",
    "zoneId": "{{sec03ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "PROVIDE",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec03Admin' });

  const providerEnvId = bru.getVar('sec03ProviderEnvId');
  const consumer1EnvId = bru.getVar('sec03Consumer1EnvId');
  const zoneId = bru.getVar('sec03ZoneId');
  if (!providerEnvId || !consumer1EnvId || !zoneId) {
    throw new Error(
      '03-event-publishing/08a: Missing setup variables. ' +
      'Ensure steps 01-07 completed successfully.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error('Failed to create PROVIDE ACL: status ' + status);
  }

  bru.setVar('sec03ProvideAclId', res.getBody().id);
  bru.setVar('sec03ContextId', 'DEFAULT');
  console.log('✓ PROVIDE ACL created: ' + res.getBody().id);
}

tests {
  test("Provider PROVIDE ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary
  Creates PROVIDE ACL for the provider environment (CertEventObjects).

  ## Expected Result
  - HTTP 201 → `sec03ProvideAclId` stored
}
