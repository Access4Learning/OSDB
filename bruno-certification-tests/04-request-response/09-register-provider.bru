meta {
  name: 09 Register Provider
  type: http
  seq: 11
}

post {
  url: {{gatewayUrl}}/{{sec04DomainId}}/{{sec04SolutionId}}/providers/provider
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "provider": {
      "environmentId": "{{sec04ProviderEnvId}}",
      "serviceName": "{{sec04ServiceName}}",
      "zoneId": "{{sec04ZoneId}}",
      "contextId": "{{sec04ContextId}}",
      "providerName": "{{sec04ProviderName}}",
      "querySupport": {},
      "serviceType": "OBJECT",
      "endPoint": {
        "location": "{{immediateProviderEndpointUrl}}/{{immediateProviderServiceName}}"
      },
      "supportedRequestTypes": {
        "supportedRequestType": [
          {
            "requestType": "IMMEDIATE",
            "operations": {
              "operation": [
                "CREATE",
                "QUERY",
                "UPDATE",
                "DELETE"
              ]
            }
          }
        ]
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.provider.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec04Admin' });

  const providerEnvId = bru.getVar('sec04ProviderEnvId');
  const sec04ServiceName = bru.getVar('sec04ServiceName');
  const sec04ZoneId = bru.getVar('sec04ZoneId');
  const sec04ContextId = bru.getVar('sec04ContextId');
  if (!providerEnvId || !sec04ServiceName || !sec04ZoneId || !sec04ContextId) {
    throw new Error(
      '04-request-response/09-register-provider: Missing sec04ProviderEnvId, sec04ServiceName, sec04ZoneId, or sec04ContextId. ' +
      'Run previous setup steps first.'
    );
  }

  const endpointUrl = bru.getEnvVar('immediateProviderEndpointUrl');
  const serviceName = bru.getEnvVar('immediateProviderServiceName');
  if (!endpointUrl || !serviceName) {
    throw new Error(
      '04-request-response/09-register-provider: Missing environment variables. ' +
      'Set immediateProviderEndpointUrl and immediateProviderServiceName in your environment file.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '04-request-response/09-register-provider FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().provider;
  bru.setVar('sec04ProviderRegistrationId', data.id);
  console.log('✓ Registered provider:', data.id);
  console.log('  Service:', data.serviceName);
  console.log('  Endpoint:', data.endPoint.location);
}

docs {
  ## Summary

  Registers the external provider for IMMEDIATE request handling.

  ## Rationale

  The provider registration tells the broker where to forward IMMEDIATE requests.
  The serviceName, zoneId and contextId were obtained from the previous step (08b-get-provider-options).

  ## Expected Result

  - HTTP 201 Created
  - Provider registration ID stored in `sec04ProviderRegistrationId`
}
