meta {
  name: 07 Create ACLs
  type: http
  seq: 7
}

post {
  url: {{gatewayUrl}}/{{sec04DomainId}}/{{sec04SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec04ProviderEnvId}}",
    "serviceName": "{{immediateProviderServiceName}}",
    "zoneId": "{{sec04ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "PROVIDE",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.zoneId: isDefined
  res.body.contextId: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec04Admin' });

  const zoneId = bru.getVar('sec04ZoneId');
  if (!zoneId) {
    throw new Error(
      '04-request-response/04-create-acls: Missing sec04ZoneId. ' +
      'Run 01-setup-zone first.'
    );
  }

  const serviceName = bru.getEnvVar('immediateProviderServiceName');
  if (!serviceName) {
    throw new Error(
      '04-request-response/04-create-acls: Missing environment variable "immediateProviderServiceName". ' +
      'Set it in your environment file (e.g., environments/local.bru).'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '04-request-response/04-create-acls: Failed to create PROVIDE ACL, got ' + status +
      '. Response: ' + JSON.stringify(res.getBody())
    );
  }

  const provideData = res.getBody();
  bru.setVar('sec04ProvideAclId', provideData.id);
  console.log('✓ Created PROVIDE ACL:', provideData.id);
}

tests {
  test("Provider PROVIDE ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary

  Creates PROVIDE ACL entry for request-response tests.

  ## Rationale

  ACL entry authorizes the provider to serve requests for the configured service
  object. Scoped to the section's zone and DEFAULT context using SIF-compliant
  `zoneId`/`contextId` identifiers.

  ## Expected Result

  - PROVIDE ACL created for provider environment → `sec04ProvideAclId`
  - Response contains `zoneId` and `contextId` fields
}
