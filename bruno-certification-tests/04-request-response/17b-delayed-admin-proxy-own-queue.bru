meta {
  name: 17b Delayed Admin No Bypass
  type: http
  seq: 23
}

get {
  url: {{sec04ConsumerRequestsUrl}}/{{immediateProviderServiceName}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  X-Run-As-Environment: {{sec04ConsumerEnvId}}
  zoneId: {{sec04ZoneId}}
  contextId: DEFAULT
  requestType: DELAYED
  queueId: {{sec04QueueId}}
  serviceType: OBJECT
}

assert {
  res.status: eq 404
  res.body.error.subCode: eq QUEUE_NOT_FOUND
}

script:pre-request {
  const auth = require('./common/auth.js');
  // Authenticate as the section ADMIN and ALSO send X-Run-As-Environment naming the
  // consumer. Neither the admin role nor the run-as header may produce a bypass:
  // impersonation of an ordinary environment is not permitted by the gateway (see docs),
  // so X-Environment-Id arrives as the ADMIN's own id and the admin does not own the
  // consumer's queue.
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec04Admin' });

  const requestsUrl = bru.getVar('sec04ConsumerRequestsUrl');
  const consumerEnvId = bru.getVar('sec04ConsumerEnvId');
  const consumerQueueId = bru.getVar('sec04QueueId');
  if (!requestsUrl || !consumerEnvId || !consumerQueueId) {
    throw new Error(
      '04-request-response/17b: Missing sec04ConsumerRequestsUrl, sec04ConsumerEnvId or ' +
      'sec04QueueId. Run the setup steps first.'
    );
  }

  // Canary: like step 17, this asserts 404 — which an over-blocking gate would also satisfy.
  // Only meaningful once step 12 has proven a legitimate DELAYED request still succeeds.
  if (bru.getVar('sec04DelayedPositivePathProven') !== 'true') {
    throw new Error(
      '04-request-response/17b: the positive DELAYED path is unproven (step 12 did not return ' +
      '202). A 404 here proves nothing about admin bypass, because an over-blocking gate ' +
      'returns 404 for everything. Fix steps 12/13/14 first, then re-run.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  const body = res.getBody();
  console.log('Admin + run-as naming the consumer\'s queue — status:', status);

  if (status === 404) {
    console.log('✓ No admin bypass — the ownership rule applied to the admin like any other caller');
    if (body && body.error) {
      console.log('  subCode:', body.error.subCode);
    }
  } else if (status === 202) {
    console.error(
      '✗ ADMIN BYPASS: the request was ACCEPTED. Either the ownership gate consulted the ' +
      'admin role / fingerprint / internal token, or gateway impersonation was widened to ' +
      'ordinary environments without updating this test. Both need review.'
    );
  } else {
    console.error('✗ Expected 404, got:', status, JSON.stringify(body));
  }
}

tests {
  test("Admin naming an environment's queue it does not own is rejected (404)", function() {
    expect(res.getStatus()).to.equal(404);
  });

  test("No admin bypass — the request is NOT accepted", function() {
    expect(res.getStatus()).to.not.equal(202);
  });

  test("Rejection is the ownership denial, not a routing or provider 404", function() {
    const body = res.getBody();
    expect(body, 'response body must be present').to.exist;
    expect(body.error, 'response must use the SIF 3.7 error envelope').to.exist;
    expect(body.error.subCode).to.equal('QUEUE_NOT_FOUND');
    expect(body.error.code).to.equal(404);
  });
}

docs {
  ## Summary

  Verifies there is **no admin bypass** of the DELAYED queue-ownership rule. The request
  authenticates as the section admin AND sends `X-Run-As-Environment: <consumerEnvId>`,
  then names the consumer's queue. It must be rejected with 404 / `QUEUE_NOT_FOUND`,
  because the effective caller is the admin, and the admin does not own that queue.

  ## Rationale — requirement 2.6

  The ownership rule is uniform: the queue named by `queueId` must be owned by the
  environment in `X-Environment-Id`. Neither the admin role, nor
  `X-Environment-Fingerprint: broker-services`, nor `X-Internal-Service-Token` is
  consulted for this decision. This step certifies that.

  ## Why the run-as header does not help here

  This step originally asserted 202, on the assumption that an admin could proxy as an
  ordinary consumer and inherit its queue ownership. **The gateway does not permit that**,
  for two independent reasons in `ProxyImpersonationFilter`:

  1. **Caller eligibility** (`:104`) — `X-Run-As-Environment` is honoured only for a
     **global** admin (`GlobalAdminConstants.isGlobalAdmin`, i.e. the GLOBAL domain and
     solution). A section/solution admin's header is ignored, and the request proceeds
     under the admin's own identity.
  2. **Target eligibility** (`:174-181`) — only environments whose fingerprint is
     `broker-services` may be impersonated at all. An ordinary consumer cannot be, even by
     a global admin (403 `PROXY_NOT_BROKER_SERVICES`).

  Impersonation exists so the admin console can act as the broker's own service identity —
  not so an admin can stand in for an arbitrary tenant. "Admin issues a DELAYED request on
  behalf of a normal environment" is therefore **not a supported flow**. Enabling it would
  be a deliberate widening of the gateway privilege model (both gates above), with its own
  spec and audit requirements — not something this gate should accommodate.

  ## Relationship to step 17

  Step 17 proves a normal consumer cannot name another environment's queue. This step
  proves elevated privilege does not change that answer. Neither is sufficient alone: a gate
  that denied *everything* would also pass both, which is why steps 12, 13, 13a, 13b, 14 and
  14b — the positive paths — are the ones that prove the gate discriminates rather than
  simply blocking.

  ## Expected Result

  - HTTP 404 Not Found
  - `error.subCode` is `QUEUE_NOT_FOUND` (the ownership denial specifically)
  - No owner or other-environment identifiers disclosed in the body
}
