meta {
  name: 13b Poll Delayed Response
  type: http
  seq: 17
}

get {
  url: {{gatewayUrl}}/{{sec04DomainId}}/{{sec04SolutionId}}/queues/{{sec04QueueId}}/messages
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  deleteMessageId: {{sec04DelayedImmMessageId}}
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec04Consumer' });

  // The provider was driven on demand in step 13a (POST /test-control/poll); allow the
  // Responses Connector to deliver the submitted response into the consumer queue.
  await new Promise(resolve => setTimeout(resolve, 5000));
}

script:post-response {
  const status = res.getStatus();
  console.log('Queue poll status:', status);

  if (status === 200) {
    const messageId = res.getHeader('messageid');
    bru.setVar('sec04DelayedDelMessageId', messageId);
    console.log('✓ Delayed response delivered to queue, messageid:', messageId);

    // Canary for step 18c. A response actually reached an entitled consumer queue, which proves
    // the destination gate is not denying everything. 18c asserts a 404 and refuses to run
    // without this, because an over-denying gate would satisfy that assertion too.
    bru.setVar('sec04DelayedResponseDeliveredProven', 'true');

    const body = res.getBody();
    console.log('  Response body:', JSON.stringify(body).substring(0, 200));
  } else if (status === 204) {
    console.log('  Queue empty — provider may not have responded yet');
    console.log('  (This is expected if no DELAYED provider is running)');
    console.log('  NOTE: step 18c will refuse to run — the positive response leg is unproven.');
  }
}

assert {
  res.status: in [200, 204]
}

tests {
  test("Queue poll returns delayed response or empty", function() {
    expect([200, 204]).to.include(res.getStatus());
  });

  test("Response delivered to consumer queue via Responses Connector", function() {
    const messageId = bru.getVar('sec04DelayedDelMessageId');
    if (messageId) {
      expect(messageId).to.be.a('string');
    } else {
      console.log('NOTE: No delayed response received — ensure a DELAYED provider is running');
    }
  });

  test("Delivered response carries the consumer's requestId token", function() {
    if (res.getStatus() === 200) {
      const receivedRequestId = res.getHeader('requestid') || res.getHeader('requestId');
      const expectedToken = bru.getVar('sec04DelayedRequestId');
      expect(receivedRequestId).to.equal(expectedToken);
    }
  });
}

docs {
  ## Summary

  Polls the consumer's queue for the DELAYED/DELAYED response, acknowledging
  the previous message from step 12b.

  ## Rationale

  After the DELAYED request (step 13) and the on-demand provider poll (step 13a), the
  test-provider submits its response via the Responses Connector, which delivers it to the
  consumer's queue. This step polls the queue with deleteMessageId to ack the previous message
  and retrieve the delayed response.

  ## Expected Result

  - HTTP 200 with response body and messageid header (happy path now that the provider is
    self-driven via step 13a), or
  - HTTP 204 if the Responses Connector has not yet delivered the response
}
