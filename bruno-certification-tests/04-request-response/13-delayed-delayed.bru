meta {
  name: 13 Delayed Delayed
  type: http
  seq: 16
}

get {
  url: {{sec04ConsumerRequestsUrl}}/{{delayedProviderServiceName}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  zoneId: {{sec04ZoneId}}
  contextId: DEFAULT
  requestType: DELAYED
  queueId: {{sec04QueueId}}
  serviceType: OBJECT
}

assert {
  res.status: eq 202
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec04Consumer' });

  const requestsUrl = bru.getVar('sec04ConsumerRequestsUrl');
  const queueId = bru.getVar('sec04QueueId');
  if (!requestsUrl || !queueId) {
    throw new Error(
      '04-request-response/13-delayed-delayed: Missing sec04ConsumerRequestsUrl or sec04QueueId. ' +
      'Run setup steps first.'
    );
  }

  const serviceName = bru.getEnvVar('delayedProviderServiceName');
  if (!serviceName) {
    throw new Error(
      '04-request-response/13-delayed-delayed: Missing delayedProviderServiceName environment variable. ' +
      'This step targets the DELAYED-only service registered in steps 09a–09f.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  console.log('DELAYED/DELAYED request response status:', status);

  if (status === 202) {
    console.log('✓ Request accepted (202)');
  } else {
    console.error('✗ Expected 202, got:', status, JSON.stringify(res.getBody()));
  }
}

tests {
  test("DELAYED/DELAYED request returns 202 Accepted", function() {
    expect(res.getStatus()).to.equal(202);
  });
}

docs {
  ## Summary

  Sends a DELAYED request for the dedicated DELAYED-only service object
  (`delayedProviderServiceName`) to exercise a true DELAYED/DELAYED choreography.

  ## Rationale

  Because the broker selects DELAYED→DELAYED vs DELAYED→IMMEDIATE from the matched provider
  registration's `supportedRequestTypes`, this step targets the separate DELAYED-only service
  registered in steps 09a–09f (same provider environment, different object). The broker accepts
  the request (202) and enqueues it to the provider's queue. The standalone test-provider then
  drains that queue on demand in step 13a (`POST /test-control/poll`), processes the request,
  and submits the response through the Responses Connector for delivery to the consumer's queue
  (polled in step 13b).

  ## Expected Result

  - HTTP 202 Accepted from the Requests Connector
}
