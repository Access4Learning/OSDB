vars {
  gatewayUrl: {{process.env.AWS_TRANSCRIPT_GATEWAY_URL}}
  currentEnv: transcript
  immediateProviderEndpointUrl: {{process.env.CERT_IMMEDIATE_PROVIDER_URL}}
  immediateProviderServiceName: TestObjects
  delayedProviderServiceName: DelayedTestObjects
  verboseLogging: true
  runAsGlobalAdmin: true
}
