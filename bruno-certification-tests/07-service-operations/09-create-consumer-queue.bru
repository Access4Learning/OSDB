meta {
  name: 09 Create Consumer Queue
  type: http
  seq: 12
}

post {
  url: {{gatewayUrl}}/{{sec07DomainId}}/{{sec07SolutionId}}/queues/queue
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "queue": {
      "name": "cert-svcops-consumer-queue",
      "ownerId": "{{sec07ConsumerEnvId}}",
      "maxRetries": 3,
      "retryDelayMs": 5000
    }
  }
}

assert {
  res.status: eq 201
  res.body.queue.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec07Consumer' });

  const consumerEnvId = bru.getVar('sec07ConsumerEnvId');
  if (!consumerEnvId) {
    throw new Error(
      '07-service-operations/06-create-consumer-queue: Missing sec07ConsumerEnvId. ' +
      'Run 03-create-consumer-env first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '07-service-operations/06-create-consumer-queue FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec07ConsumerQueueId', data.queue.id);
  console.log('Created consumer queue:', data.queue.id);
}

docs {
  ## Summary

  Creates a queue owned by the consumer environment for receiving DELAYED responses.

  ## Rationale

  DELAYED service operations require a consumer queue where the broker delivers
  responses. The consumer passes this queue ID in the `queueId` header when
  sending operations to the Services Connector.

  ## Expected Result

  - HTTP 201 Created
  - Consumer queue ID stored in `sec07ConsumerQueueId` Bruno variable
}
