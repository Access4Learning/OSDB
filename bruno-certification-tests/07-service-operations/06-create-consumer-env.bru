meta {
  name: 06 Create Consumer Environment
  type: http
  seq: 6
}

post {
  url: {{gatewayUrl}}/{{sec07DomainId}}/{{sec07SolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "applicationName": "CertSvcOpsConsumer-{{$timestamp}}",
    "type": "BROKERED",
    "defaultZoneId": "{{sec07ZoneId}}"
  }
}

assert {
  res.status: eq 201
  res.body.environment.id: isDefined
  res.body.environment.sessionToken: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec07Admin' });

  const zoneId = bru.getVar('sec07ZoneId');
  if (!zoneId) {
    throw new Error(
      '07-service-operations/03-create-consumer-env: Missing sec07ZoneId. ' +
      'Run 01-setup-zone first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '07-service-operations/03-create-consumer-env FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().environment;
  bru.setVar('sec07ConsumerEnvId', data.id);
  bru.setVar('sec07ConsumerSessionToken', data.sessionToken);
  bru.setVar('sec07ConsumerSharedSecret', data.sharedSecret);

  // Extract servicesConnector URL from consumer infrastructure services
  if (data.infrastructureServices && data.infrastructureServices.infrastructureService) {
    const services = data.infrastructureServices.infrastructureService;

    const servicesConn = services.find(s => s.name === 'servicesConnector');
    if (servicesConn) {
      bru.setVar('sec07ConsumerServicesUrl', servicesConn.value);
      console.log('  Services Connector URL:', servicesConn.value);
    }

    const queuesConn = services.find(s => s.name === 'queues');
    if (queuesConn) {
      bru.setVar('sec07ConsumerQueuesUrl', queuesConn.value);
      console.log('  Consumer Queues URL:', queuesConn.value);
    }
  }

  console.log('âœ“ Created consumer environment (BROKERED):', data.id);
}

docs {
  ## Summary

  Creates a BROKERED consumer environment for service operations tests.

  ## Rationale

  A BROKERED consumer environment sends service operations via the broker's
  Services Connector. The consumer's infrastructure services include the
  servicesConnector URL used for all functional service CRUD operations.

  ## Expected Result

  - HTTP 201 Created
  - Consumer environment ID, session token, shared secret stored
  - Services Connector URL extracted and stored in `sec07ConsumerServicesUrl`
  - Consumer Queues URL stored in `sec07ConsumerQueuesUrl`
  - `sec07ConsumerEnvId`, `sec07ConsumerSessionToken`, `sec07ConsumerSharedSecret` set
}
