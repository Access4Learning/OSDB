meta {
  name: 07c Create Consumer UPDATE ACL
  type: http
  seq: 9
}

post {
  url: {{gatewayUrl}}/{{sec07DomainId}}/{{sec07SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec07ConsumerEnvId}}",
    "serviceName": "CertFunctionalService",
    "zoneId": "{{sec07ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "UPDATE",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec07Admin' });
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '07-service-operations/07c: Failed to create UPDATE ACL, got ' +
      status + ': ' + JSON.stringify(res.getBody())
    );
  }
  bru.setVar('sec07UpdateAclId', res.getBody().id);
  console.log('✓ Created UPDATE ACL:', res.getBody().id);
}

tests {
  test("Consumer UPDATE ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary
  Creates UPDATE ACL for consumer (allows PUT operations on CertFunctionalService).
}
