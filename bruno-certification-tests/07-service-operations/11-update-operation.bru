meta {
  name: 11 Update Operation
  type: http
  seq: 14
}

put {
  url: {{sec07ConsumerServicesUrl}}/{{sec07ServiceName}}
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  zoneId: {{sec07ZoneId}}
  contextId: DEFAULT
  requestType: DELAYED
  queueId: {{sec07ConsumerQueueId}}
  serviceName: {{sec07ServiceName}}
}

body:json {
  {
    "operation": "UPDATE",
    "data": {
      "name": "CertTestJob-Updated",
      "description": "Updated certification test job via service operations",
      "status": "IN_PROGRESS"
    }
  }
}

assert {
  res.status: eq 202
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec07Consumer' });

  const servicesUrl = bru.getVar('sec07ConsumerServicesUrl');
  const queueId = bru.getVar('sec07ConsumerQueueId');
  const serviceName = bru.getVar('sec07ServiceName');
  if (!servicesUrl || !queueId || !serviceName) {
    throw new Error(
      '07-service-operations/11-update-operation: Missing sec07ConsumerServicesUrl, ' +
      'sec07ConsumerQueueId, or sec07ServiceName. Run setup steps first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  console.log('UPDATE service operation response status:', status);

  if (status === 202) {
    console.log('✓ UPDATE operation accepted (202)');
  } else {
    console.error('✗ Expected 202, got:', status, JSON.stringify(res.getBody()));
  }
}

tests {
  test("PUT (UPDATE) service operation returns 202 Accepted", function() {
    expect(res.getStatus()).to.equal(202);
  });
}

docs {
  ## Summary

  Sends a PUT (UPDATE) service operation to the Services Connector with
  requestType=DELAYED and a valid queueId.

  ## Rationale

  The UPDATE operation verifies that the broker accepts a functional service
  update request via PUT and routes it asynchronously. The broker must return
  202 Accepted, confirming the update operation has been enqueued for the provider.

  ## Expected Result

  - HTTP 202 Accepted
  - Update operation enqueued to provider's queue for processing
}
