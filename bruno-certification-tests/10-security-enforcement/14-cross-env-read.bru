meta {
  name: 14 Cross-Env Read
  type: http
  seq: 15
}

get {
  url: {{gatewayUrl}}/{{sec10DomainId}}/{{sec10SolutionId}}/environments/{{sec10Consumer2EnvId}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 403
  res.body.error.id: isDefined
  res.body.error.code: isDefined
  res.body.error.message: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  // Authenticate as Consumer 1 â€” trying to read Consumer 2's environment config
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec10Consumer1' });

  const consumer2EnvId = bru.getVar('sec10Consumer2EnvId');
  if (!consumer2EnvId) {
    throw new Error(
      '10-security-enforcement/14-cross-env-read: Missing sec10Consumer2EnvId.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  console.log('Consumer 1 attempted to read Consumer 2 config â†’ status: ' + status);

  if (status === 403) {
    console.log('âœ“ Correctly rejected: environments cannot read other envs config');
    const body = res.getBody();
    bru.setVar('sec10CrossEnvReadBody', JSON.stringify(body));
  } else {
    console.error('âœ— Expected 403, got: ' + status);
  }
}

tests {
  test("Cross-environment read rejected with 403 Forbidden", function() {
    expect(res.getStatus()).to.equal(403);
  });

  test("Error response contains message field", function() {
    const data = res.getBody();
    expect(data).to.have.property('error');
    expect(data.error).to.have.property('message');
    expect(data.error.message).to.be.a('string');
    expect(data.error.message.length).to.be.greaterThan(0);
  });

  test("Environments are isolated from each other", function() {
    // An environment should only be able to read its own configuration
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  ## Summary

  Verifies that a non-admin environment cannot read another environment's
  configuration.

  ## Rationale

  SIF enforces environment isolation â€” each environment can only access its own
  data. Consumer 1 attempting to read Consumer 2's environment configuration must
  be rejected with 403. This prevents information disclosure between tenants
  sharing the same broker.

  ## Expected Result

  - HTTP 403 Forbidden
  - Response body contains `message` field indicating access restricted to own environment
}
