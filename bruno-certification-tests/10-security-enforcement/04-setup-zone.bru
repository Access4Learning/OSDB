meta {
  name: 04 Setup Zone
  type: http
  seq: 4
}

post {
  url: {{gatewayUrl}}/{{sec10DomainId}}/{{sec10SolutionId}}/zones/zone
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
  X-Run-As-Environment: broker-services
}

body:json {
  {
    "zone": {
      "id": "SecEnfTestZone-{{$timestamp}}",
      "description": "Zone for security enforcement certification tests"
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec10Admin' });
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '10-security-enforcement/01-setup-zone FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec10ZoneId', data.zone.id);
  console.log('âœ“ Section 10 zone created: ' + bru.getVar('sec10ZoneId'));
}

assert {
  res.status: eq 201
}

tests {
  test("Zone created successfully", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Response contains wrapped zone with id", function() {
    const data = res.getBody();
    expect(data).to.have.property('zone');
    expect(data.zone).to.have.property('id');
  });
}

docs {
  ## Summary

  Creates a dedicated zone for security enforcement tests.

  ## Rationale

  Each certification test section operates in its own zone to ensure complete isolation
  from other test sections. The zone is created with a timestamp suffix to avoid
  collisions across parallel runs.

  ## Expected Result

  - HTTP 201 Created
  - `sec10ZoneId` variable stored for use by subsequent setup and teardown steps
}
