meta {
  name: 08c Create Consumer2 QUERY ACL
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{sec10DomainId}}/{{sec10SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec10Consumer2EnvId}}",
    "serviceName": "CertSecurityObjects",
    "zoneId": "{{sec10ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "QUERY",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec10Admin' });
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error('Failed to create Consumer 2 QUERY ACL: status ' + status);
  }
  bru.setVar('sec10Consumer2QueryAclId', res.getBody().id);
  console.log('✓ Consumer 2 QUERY ACL created: ' + res.getBody().id);
}

tests {
  test("Consumer 2 QUERY ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary
  Creates QUERY ACL for Consumer 2 (no SUBSCRIBE — deliberate restriction for security tests).

  ## Expected Result
  - HTTP 201 → `sec10Consumer2QueryAclId` stored
}
