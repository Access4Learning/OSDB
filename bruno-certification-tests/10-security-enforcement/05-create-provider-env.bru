meta {
  name: 05 Create Provider Environment
  type: http
  seq: 5
}

post {
  url: {{gatewayUrl}}/{{sec10DomainId}}/{{sec10SolutionId}}/environments/environment
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "applicationName": "sec10-provider-{{$timestamp}}",
    "type": "BROKERED",
    "defaultZoneId": "{{sec10ZoneId}}"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec10Admin' });

  const zoneId = bru.getVar('sec10ZoneId');
  if (!zoneId) {
    throw new Error(
      '10-security-enforcement/02-create-provider-env: Missing sec10ZoneId. ' +
      'Step 01-setup-zone must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '10-security-enforcement/02-create-provider-env FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec10ProviderEnvId', data.id);
  bru.setVar('sec10ProviderSessionToken', data.sessionToken);
  bru.setVar('sec10ProviderSharedSecret', data.sharedSecret);
  console.log('âœ“ Provider environment created: ' + data.id);
}

assert {
  res.status: eq 201
  res.body.id: isDefined
  res.body.sessionToken: isDefined
}

tests {
  test("Provider environment created with type DIRECT", function() {
    expect(res.getStatus()).to.equal(201);
    const data = res.getBody();
    expect(data.id).to.exist;
    expect(data.sessionToken).to.exist;
  });
}

docs {
  ## Summary

  Registers a provider environment (type DIRECT) for security enforcement tests.

  ## Rationale

  The provider environment will be granted a PROVIDE ACL. It serves as a non-admin
  environment that can be used to test admin-only operation restrictions (create zone,
  create context) and cross-environment isolation (reading another env's config/queue).

  ## Expected Result

  - HTTP 201 Created
  - Response body contains `id`, `sessionToken`, `sharedSecret`
  - `sec10ProviderEnvId`, `sec10ProviderSessionToken`, `sec10ProviderSharedSecret` stored
}
