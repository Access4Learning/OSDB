meta {
  name: 15 Cross-Env Queue Read
  type: http
  seq: 16
}

get {
  url: {{sec10Consumer1QueuesUrl}}
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

assert {
  res.status: eq 200
}

script:pre-request {
  const auth = require('./common/auth.js');
  // Authenticate as Consumer 2 — trying to read Consumer 1's queues
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec10Consumer2' });

  const consumer1QueuesUrl = bru.getVar('sec10Consumer1QueuesUrl');
  if (!consumer1QueuesUrl) {
    throw new Error(
      '10-security-enforcement/15-cross-env-queue-read: Missing sec10Consumer1QueuesUrl.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  console.log('Consumer 2 attempted to read Consumer 1 queues → status: ' + status);

  if (status === 200) {
    const body = res.getBody();
    const queues = body.queues?.queue || [];
    console.log('✓ Queue list returned but filtered by ownership — Consumer 2 sees ' + queues.length + ' queue(s)');
    bru.setVar('sec10CrossEnvQueueReadBody', JSON.stringify(body));
  }
}

tests {
  test("Queue list endpoint returns 200 (filtered by authenticated caller)", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Consumer 2 does not see Consumer 1 queues (ownership filter)", function() {
    // The queue list is scoped to the calling environment's ownership
    // Consumer 2 has no queues, so the list should be empty
    const body = res.getBody();
    const queues = body.queues?.queue || [];
    expect(queues).to.be.an('array');
    // Consumer 2 owns no queues — verify none of Consumer 1's queues leak through
    const consumer1EnvId = bru.getVar('sec10Consumer1EnvId');
    const leakedQueues = queues.filter(q => q.ownerId === consumer1EnvId);
    expect(leakedQueues).to.have.length(0);
  });

  test("Queue access is correctly isolated by environment ownership", function() {
    // An environment only sees its own queues in the list response
    const body = res.getBody();
    const queues = body.queues?.queue || [];
    const consumer2EnvId = bru.getVar('sec10Consumer2EnvId');
    queues.forEach(q => {
      expect(q.ownerId).to.equal(consumer2EnvId);
    });
  });
}

docs {
  ## Summary

  Verifies that a non-admin environment cannot read messages from a queue owned
  by a different environment.

  ## Rationale

  SIF enforces queue isolation — each environment can only access queues it owns.
  Consumer 2 attempting to read Consumer 1's queue endpoint must be rejected with 403.
  This prevents unauthorized message access and ensures data confidentiality between
  environments sharing the same broker.

  ## Expected Result

  - HTTP 403 Forbidden
  - Response body contains `message` field indicating queue access restricted to owner
}
