meta {
  name: 03 Get Admin Environment
  type: http
  seq: 3
}

get {
  url: {{gatewayUrl}}/{{sec10DomainId}}/{{sec10SolutionId}}/environments
  body: none
  auth: none
}

headers {
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

script:pre-request {
  const auth = require('./common/auth.js');

  // In solution-admin runs, the create-domain / create-solution steps are excluded
  // (globaladminonly), so resolve the pre-provisioned scope from .env here.
  if (!auth.isGlobalAdminRun(bru)) {
    const envPrefix = bru.getEnvVar('currentEnv');
    const domainId = bru.interpolate('{{process.env.' + envPrefix + '-domainId}}');
    const solutionId = bru.interpolate('{{process.env.' + envPrefix + '-solutionId}}');
    if (!domainId || domainId.indexOf('process.env') !== -1) {
      throw new Error(
        '10-security-enforcement/03-get-admin-environment: solution-admin run requires .env key "'
        + envPrefix + '-domainId".'
      );
    }
    if (!solutionId || solutionId.indexOf('process.env') !== -1) {
      throw new Error(
        '10-security-enforcement/03-get-admin-environment: solution-admin run requires .env key "'
        + envPrefix + '-solutionId".'
      );
    }
    bru.setVar('sec10DomainId', domainId);
    bru.setVar('sec10SolutionId', solutionId);
  }

  // Global-admin runs authenticate as 'admin'; solution-admin runs as 'solutionAdmin'.
  auth.setAuthHeaders(req, bru, auth.sectionAdminRole(bru));

  const domainId = bru.getVar('sec10DomainId');
  const solutionId = bru.getVar('sec10SolutionId');
  if (!domainId || !solutionId) {
    throw new Error(
      '10-security-enforcement/03-get-admin-environment: Missing sec10DomainId or sec10SolutionId. ' +
      'In global-admin runs, steps 01-create-domain and 02-create-solution must run first; ' +
      'in solution-admin runs, set {currentEnv}-domainId / -solutionId in .env.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '10-security-enforcement/03-get-admin-environment FAILED: expected 200, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  let envs = [];
  if (Array.isArray(data)) {
    envs = data;
  } else if (data && data.environments && data.environments.environment && Array.isArray(data.environments.environment)) {
    envs = data.environments.environment;
  } else if (data && data.environment && Array.isArray(data.environment)) {
    envs = data.environment;
  } else if (data && data.environments && Array.isArray(data.environments)) {
    envs = data.environments;
  } else if (data && data.content && Array.isArray(data.content)) {
    envs = data.content;
  }

  const brokerEnv = envs.find(e =>
    (e.fingerprint && e.fingerprint === 'broker-services') ||
    (e.consumerName && e.consumerName.startsWith('BROKER_SERVICES'))
  );

  if (!brokerEnv) {
    throw new Error(
      '10-security-enforcement/03-get-admin-environment FAILED: No broker-services environment found. ' +
      'Found ' + envs.length + ' environment(s).'
    );
  }

  bru.setVar('sec10AdminEnvironmentId', brokerEnv.id);

  // Store admin credentials from .env into Bruno vars for { varPrefix: 'sec10Admin' } usage.
  // Global-admin runs use the 'admin' role; solution-admin runs use 'solutionAdmin'.
  const auth = require('./common/auth.js');
  const envPrefix = bru.getEnvVar('currentEnv');
  const role = auth.sectionAdminRole(bru);
  const sessionTokenKey = envPrefix + '-' + role + 'SessionToken';
  const sharedSecretKey = envPrefix + '-' + role + 'SharedSecret';
  const sessionTokenPath = '{{process.env.' + sessionTokenKey + '}}';
  const sharedSecretPath = '{{process.env.' + sharedSecretKey + '}}';
  const adminSessionToken = bru.interpolate(sessionTokenPath);
  const adminSharedSecret = bru.interpolate(sharedSecretPath);

  if (!adminSessionToken || adminSessionToken === sessionTokenPath) {
    throw new Error(
      '10-security-enforcement/03-get-admin-environment: Could not resolve admin session token. ' +
      'Expected .env key: ' + sessionTokenKey
    );
  }
  if (!adminSharedSecret || adminSharedSecret === sharedSecretPath) {
    throw new Error(
      '10-security-enforcement/03-get-admin-environment: Could not resolve admin shared secret. ' +
      'Expected .env key: ' + sharedSecretKey
    );
  }

  bru.setVar('sec10AdminSessionToken', adminSessionToken);
  bru.setVar('sec10AdminSharedSecret', adminSharedSecret);
  console.log('Admin environment found: ' + brokerEnv.id);
}

docs {
  ## Summary
  Retrieves the broker-services environment and stores admin credentials for section 10.

  ## Expected Result
  - HTTP 200 OK
  - sec10AdminEnvironmentId, sec10AdminSessionToken, sec10AdminSharedSecret stored
}
