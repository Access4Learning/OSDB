meta {
  name: 20 Non-Admin Create Code Set
  type: http
  seq: 20
}

post {
  url: {{gatewayUrl}}/{{sec12DomainId}}/{{sec12SolutionId}}/codeSets/codeSet
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "codeSet": {
      "zone": "environment-global",
      "version": "1.0",
      "timestamp": "2024-01-01T00:00:00Z",
      "codeItems": {
        "codeItem": [
          { "code": "X", "value": "SHOULD_FAIL", "action": "ADD", "timestamp": "2024-01-01T00:00:00Z" }
        ]
      }
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec12Consumer' });

  const consumerToken = bru.getVar('sec12ConsumerSessionToken');
  if (!consumerToken) {
    throw new Error(
      '12-codesets/20-nonadmin-create-codeset: Missing sec12ConsumerSessionToken. ' +
      'Step 04-create-consumer-env must run successfully first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status === 201) {
    throw new Error(
      '12-codesets/20-nonadmin-create-codeset FAILED: expected 403, got 201. ' +
      'Non-admin should not be able to create code sets.'
    );
  }
  console.log('✓ Non-admin create correctly rejected with status: ' + status);
}

assert {
  res.status: eq 403
}

tests {
  test("Non-admin create rejected with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  ## Summary
  Attempts to create a code set as a non-admin consumer.

  ## Rationale
  Code set management is admin-only. Non-admin environments should receive 403 Forbidden.

  ## Expected Result
  - HTTP 403 Forbidden
}

