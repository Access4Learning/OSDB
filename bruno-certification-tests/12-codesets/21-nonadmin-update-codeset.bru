meta {
  name: 21 Non-Admin Update Code Set
  type: http
  seq: 21
}

put {
  url: {{gatewayUrl}}/{{sec12DomainId}}/{{sec12SolutionId}}/codeSets/nonexistent-id
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "codeSet": {
      "zone": "environment-global",
      "version": "2.0",
      "timestamp": "2024-06-01T00:00:00Z",
      "codeItems": {
        "codeItem": [
          { "code": "X", "value": "SHOULD_FAIL", "action": "ADD", "timestamp": "2024-06-01T00:00:00Z" }
        ]
      }
    }
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec12Consumer' });
}

script:post-response {
  const status = res.getStatus();
  if (status === 200) {
    throw new Error(
      '12-codesets/21-nonadmin-update-codeset FAILED: expected 403, got 200. ' +
      'Non-admin should not be able to update code sets.'
    );
  }
  console.log('✓ Non-admin update correctly rejected with status: ' + status);
}

assert {
  res.status: eq 403
}

tests {
  test("Non-admin update rejected with 403", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  ## Summary
  Attempts to update a code set as a non-admin consumer.

  ## Rationale
  Code set management is admin-only. Non-admin environments should receive 403 Forbidden.

  ## Expected Result
  - HTTP 403 Forbidden
}

