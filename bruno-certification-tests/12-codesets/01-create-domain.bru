meta {
  name: 01 Create Domain
  type: http
  seq: 1
  tags: [
    globaladminonly
  ]
}

post {
  url: {{gatewayUrl}}/domains
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "domainId": "{{sec12DomainName}}",
    "description": "SIF certification domain for section 12 (codesets)"
  }
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, 'admin');

  const now = new Date();
  const ts = now.getFullYear().toString()
    + String(now.getMonth() + 1).padStart(2, '0')
    + String(now.getDate()).padStart(2, '0')
    + '-'
    + String(now.getHours()).padStart(2, '0')
    + String(now.getMinutes()).padStart(2, '0')
    + String(now.getSeconds()).padStart(2, '0')
    + String(now.getMilliseconds()).padStart(3, '0');
  const domainName = 'cert-sec12-' + ts;
  bru.setVar('sec12DomainName', domainName);
}

script:post-response {
  const status = res.getStatus();
  if (status < 200 || status > 201) {
    throw new Error(
      '12-codesets/01-create-domain FAILED: expected 200-201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  const domainId = data.domainId || bru.getVar('sec12DomainName');
  bru.setVar('sec12DomainId', domainId);
  console.log('✓ Domain created: ' + domainId);
}

assert {
  res.status: in [200, 201]
}

tests {
  test("Domain created successfully", function() {
    expect(res.getStatus()).to.be.oneOf([200, 201]);
  });

  test("Domain ID stored", function() {
    expect(bru.getVar('sec12DomainId')).to.exist;
  });
}

docs {
  ## Summary
  Creates a uniquely-named domain for the code sets test section.

  ## Rationale
  Each certification section operates in its own domain for complete isolation.

  ## Expected Result
  - HTTP 201 Created
  - `sec12DomainId` variable stored for subsequent steps
}

