meta {
  name: 07 Create Provider PROVIDE ACL
  type: http
  seq: 7
}

post {
  url: {{gatewayUrl}}/{{sec15DomainId}}/{{sec15SolutionId}}/acl-entries
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "environmentId": "{{sec15ProviderEnvId}}",
    "serviceName": "StudentPersonals",
    "zoneId": "{{sec15ZoneId}}",
    "contextId": "DEFAULT",
    "accessType": "PROVIDE",
    "accessLevel": "APPROVED"
  }
}

assert {
  res.status: eq 201
  res.body.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec15Admin' });

  const providerEnvId = bru.getVar('sec15ProviderEnvId');
  const zoneId = bru.getVar('sec15ZoneId');
  if (!providerEnvId || !zoneId) {
    throw new Error(
      '15-service-type-validation/07-create-provider-acl: Missing sec15ProviderEnvId or sec15ZoneId. ' +
      'Run previous setup steps first.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '15-service-type-validation/07-create-provider-acl: Failed to create PROVIDE ACL, got ' + status +
      '. Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody();
  bru.setVar('sec15ProvideAclId', data.id);
  console.log('Created PROVIDE ACL:', data.id);
}

tests {
  test("Provider PROVIDE ACL created", function() {
    expect(res.getStatus()).to.equal(201);
  });
}

docs {
  ## Summary
  Creates PROVIDE ACL entry for the provider environment on StudentPersonals.

  ## Rationale
  ACL entry authorizes the provider to serve requests for StudentPersonals.
  This is needed so the provider can be registered and requests would normally
  succeed (proving it's the serviceType that causes rejection).

  ## Expected Result
  - PROVIDE ACL created for provider environment → `sec15ProvideAclId`
}
