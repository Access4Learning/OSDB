meta {
  name: 10 Register Provider
  type: http
  seq: 10
}

post {
  url: {{gatewayUrl}}/{{sec15DomainId}}/{{sec15SolutionId}}/providers/provider
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: {{authorizationHeader}}
  timestamp: {{timestampHeader}}
}

body:json {
  {
    "provider": {
      "environmentId": "{{sec15ProviderEnvId}}",
      "serviceName": "{{sec15ServiceName}}",
      "zoneId": "{{sec15ZoneId}}",
      "contextId": "{{sec15ContextId}}",
      "providerName": "{{sec15ProviderName}}",
      "querySupport": {},
      "serviceType": "OBJECT",
      "endPoint": {
        "location": "{{immediateProviderEndpointUrl}}/StudentPersonals"
      },
      "supportedRequestTypes": {
        "supportedRequestType": [
          {
            "requestType": "IMMEDIATE",
            "operations": {
              "operation": [
                "CREATE",
                "QUERY",
                "UPDATE",
                "DELETE"
              ]
            }
          }
        ]
      }
    }
  }
}

assert {
  res.status: eq 201
  res.body.provider.id: isDefined
}

script:pre-request {
  const auth = require('./common/auth.js');
  auth.setAuthHeaders(req, bru, { varPrefix: 'sec15Admin' });

  const providerEnvId = bru.getVar('sec15ProviderEnvId');
  const sec15ServiceName = bru.getVar('sec15ServiceName');
  const sec15ZoneId = bru.getVar('sec15ZoneId');
  const sec15ContextId = bru.getVar('sec15ContextId');
  if (!providerEnvId || !sec15ServiceName || !sec15ZoneId || !sec15ContextId) {
    throw new Error(
      '15-service-type-validation/10-register-provider: Missing sec15ProviderEnvId, sec15ServiceName, sec15ZoneId, or sec15ContextId. ' +
      'Run previous setup steps first.'
    );
  }

  const endpointUrl = bru.getEnvVar('immediateProviderEndpointUrl');
  if (!endpointUrl) {
    throw new Error(
      '15-service-type-validation/10-register-provider: Missing environment variable "immediateProviderEndpointUrl". ' +
      'Set it in your environment file.'
    );
  }
}

script:post-response {
  const status = res.getStatus();
  if (status !== 201) {
    throw new Error(
      '15-service-type-validation/10-register-provider FAILED: expected 201, got ' + status + '. ' +
      'Response: ' + JSON.stringify(res.getBody())
    );
  }

  const data = res.getBody().provider;
  bru.setVar('sec15ProviderRegistrationId', data.id);
  console.log('Registered provider:', data.id);
  console.log('  Service: StudentPersonals');
  console.log('  Endpoint:', data.endPoint.location);
}

docs {
  ## Summary
  Registers the provider for IMMEDIATE request handling on StudentPersonals.

  ## Rationale
  The provider registration tells the broker where to forward requests for
  StudentPersonals. With this in place, a valid request with `serviceType: OBJECT`
  would succeed — proving that negative tests with wrong serviceType get rejected
  by the filter, not by missing provider.

  ## Expected Result
  - HTTP 201 Created
  - Provider registration ID stored in `sec15ProviderRegistrationId`
}
